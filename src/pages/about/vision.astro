---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CTA from "../../components/CTA.astro";

const title = "Vision — Brand Evolution of Third Eye Events | Third Eye Events";
const description =
  "The vision behind Third Eye Events — from dance to performance, creation to events, experiences to execution, IP Events to purpose. A brand built on meaning, not noise.";
---

<BaseLayout title={title} description={description} path="/about/vision/">
  <PageHero
    image="/images/about/vision-hero.jpg"
    eyebrow="About"
    title="The Vision"
    statement="Not built on events. Built on purpose."
  />

  <section class="section evolution atmosphere-radial">
    <div class="container">
      <p class="eyebrow reveal">Brand Evolution</p>
      <div class="evo reveal" style="--reveal-delay: 120ms">
        {
          ["Dance", "Performance", "Creation", "Events", "Experiences", "Execution", "IP Events", "Purpose"].map((s) => (
            <span class="evo__step microcopy">{s}</span>
          ))
        }
      </div>
      <p class="text-muted measure reveal" style="--reveal-delay: 300ms">
        Each step has been a natural evolution — not a pivot, but a deepening. What started on stage became
        a philosophy of experience. What began as choreography became curation. What was once performance
        became purpose.
      </p>
      <p class="text-muted measure reveal" style="--reveal-delay: 420ms">
        The vision is not to be the biggest. It is to be the most meaningful — where every event, every frame,
        every experience carries weight, carries culture, carries something worth remembering.
      </p>
    </div>
  </section>

  <section class="section related" aria-label="Related">
    <div class="container rel-grid">
      <a class="rel reveal" href="/about/story/">
        <span class="microcopy">About</span>
        <span class="display rel__label">Our Story →</span>
      </a>
      <a class="rel reveal" href="/about/founder/" style="--reveal-delay: 110ms">
        <span class="microcopy">About</span>
        <span class="display rel__label">Meet the Founder →</span>
      </a>
      <a class="rel reveal" href="/about/philosophy/" style="--reveal-delay: 220ms">
        <span class="microcopy">About</span>
        <span class="display rel__label">Our Philosophy →</span>
      </a>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .evolution {
    scroll-margin-top: var(--nav-h);
  }

  .evo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.2rem;
    margin-top: 2.5rem;
  }

  .evo__step {
    padding: 0.8em 1.4em;
    border: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .evo__step:not(:last-child)::after {
    content: "→";
    margin-left: 2.2rem;
    color: var(--color-bronze);
  }

  .rel-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 56em) {
    .rel-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .rel {
    display: grid;
    gap: 0.9rem;
    padding: 1.75rem;
    border: 1px solid var(--line);
    transition: border-color var(--dur-standard) ease;
  }

  .rel:hover {
    border-color: var(--color-gold);
  }

  .rel__label {
    font-size: clamp(1.3rem, 2vw, 1.7rem);
  }
</style>
