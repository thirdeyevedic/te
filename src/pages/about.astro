---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceImage from "../components/ExperienceImage.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import { founderTimeline } from "../data/founder";
import { SITE_URL, ORG_ID } from "../data/site";

const title = "About — Not Built on Events. Built on Vision. | Third Eye Events";
const description =
  "The story of Third Eye Events and founder Gautam GS — from dancer to choreographer to creator to entrepreneur to experience builder. From struggle to stage, stage to scale, scale to purpose.";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}#gautam-gs`,
  name: "Gautam GS",
  jobTitle: "Founder · Director · Choreographer · Designer",
  worksFor: { "@id": ORG_ID },
};
---

<BaseLayout title={title} description={description} path="/about/" structuredData={[personSchema]}>
  <PageHero
    image="/images/about/hero.jpg"
    eyebrow="About"
    title="Not built on events. Built on vision."
    statement="From struggle to stage. From stage to scale. From scale to purpose."
  />

  <!-- STORY -->
  <section class="section" id="story" aria-labelledby="story-title">
    <div class="container story__grid">
      <figure class="ph ph--imaged ph--framed story__portrait reveal-mask">
        <ExperienceImage
          src="/images/about/archival-dance.jpg"
          alt="Archival performance imagery from the years on stage"
          fill
        />
        <span class="ph__scrim" aria-hidden="true"></span>
      </figure>
      <div class="story__text">
        <p class="eyebrow reveal">The Story</p>
        <h2 class="display section-title reveal" style="--reveal-delay: 120ms" id="story-title">
          Struggle. Discipline.<br />Growth. Vision. Purpose.
        </h2>
        <p class="text-muted measure reveal" style="--reveal-delay: 240ms">
          Every great creation begins with a journey built on संघर्ष, अनुशासन, और अटूट समर्पण.
          From Bareilly streets to Delhi stages, Gautam GS earned his place through long rehearsals, silent struggles and absolute commitment.
          Mumbai refined the vision — 300+ stage performances, Amitabh Bachchan, Dance India Dance Super Moms, Star Guild Awards.
          Global exposure followed — Johannesburg, Bangkok, Dubai, Saudi Arabia.
          In 2013 he founded BMP Fire. In 2016 Third Eye was born — first as a dance company, then as Third Eye Events.
          From struggle to stage, stage to scale, scale to purpose.
        </p>
      </div>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="section-lg founder atmosphere-radial" id="founder" aria-labelledby="founder-title">
    <div class="container">
      <div class="founder__header">
        <p class="eyebrow reveal">Founder</p>
        <h2 class="display founder__name reveal" style="--reveal-delay: 120ms" id="founder-title">Gautam GS</h2>
        <p class="microcopy reveal" style="--reveal-delay: 220ms">Director · Choreographer · Designer · Visionary</p>
      </div>

      <ol role="list" class="path" style="list-style:none">
        {
          ["Dancer", "Choreographer", "Creator", "Entrepreneur", "Experience Builder"].map((stage, i) => (
            <li class="path__node reveal" style={`--reveal-delay: ${i * 90}ms`}>
              <span class="microcopy path__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="display path__label">{stage}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="section timeline" aria-labelledby="timeline-title">
    <div class="container">
      <h2 class="eyebrow reveal" id="timeline-title">The Journey</h2>
      <ul role="list" class="tl">
        {
          founderTimeline.map((m, i) => (
            <li class="tl__item reveal" style={`--reveal-delay: ${i * 70}ms`}>
              <span class="display tl__period">{m.period}</span>
              <div class="tl__content">
                <h3 class="tl__title">{m.title}</h3>
                <p class="text-muted tl__detail">{m.detail}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section class="section philosophy atmosphere-radial" id="philosophy" aria-labelledby="philosophy-title">
    <div class="container">
      <h2 class="eyebrow reveal" id="philosophy-title">Philosophy</h2>
      <div class="philosophy__text">
        <p class="display philosophy__line reveal" style="--reveal-delay: 120ms">
          Meaning over decoration. Emotion over performance.
        </p>
        <p class="display philosophy__line reveal" style="--reveal-delay: 260ms">
          Discipline over hype. Culture over trend.
        </p>
      </div>
      <p class="text-muted measure reveal" style="--reveal-delay: 400ms">
        These are not slogans. They are operating principles — visible in every mandap we build, every entry
        we direct and every frame we facilitate.
      </p>
      <p class="text-muted measure reveal" style="--reveal-delay: 520ms">
        Core belief: No alcohol, No non-vegetarian food, Only Satvik conscious celebrations. Because purity enhances experience and rituals deserve respect.
      </p>
    </div>
  </section>

  <!-- EVOLUTION -->
  <section class="section evolution" id="vision" aria-labelledby="vision-title">
    <div class="container">
      <h2 class="eyebrow reveal" id="vision-title">Brand Evolution · The Vision</h2>
      <div class="evo reveal">
        {
          ["Dance", "Performance", "Creation", "Events", "Experiences", "Execution", "IP Events", "Purpose"].map((s) => (
            <span class="evo__step microcopy">{s}</span>
          ))
        }
      </div>
    </div>
  </section>

  <CTA title="Continue With Us" />

  <style>
    .section-title {
      font-size: clamp(2.2rem, 5vw, 4rem);
      margin-block: 1.2rem;
      line-height: 1.1;
    }

    .story__grid {
      display: grid;
      gap: clamp(3rem, 6vw, 5rem);
      align-items: center;
    }

    @media (min-width: 64em) {
      .story__grid {
        grid-template-columns: minmax(16rem, 24rem) 1fr;
        scroll-margin-top: var(--nav-h);
      }
    }

    .story__portrait {
      aspect-ratio: 4 / 5;
      scroll-margin-top: var(--nav-h);
    }

    .story__text {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    /* Founder */
    .founder {
      scroll-margin-top: var(--nav-h);
    }

    .founder__header {
      text-align: center;
      margin-bottom: clamp(3rem, 7vw, 5rem);
    }

    .founder__name {
      font-size: clamp(2.8rem, 8vw, 6.5rem);
      margin-block: 1rem;
      text-align: center;
      line-height: 1.1;
    }

    .path {
      margin-top: clamp(3rem, 7vw, 5rem);
    }

    .path__node {
      display: flex;
      align-items: baseline;
      gap: 2.5rem;
      padding-block: 1.4rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      transition: background 0.3s var(--ease-in-out-soft);
    }

    .path__node:first-child {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .path__node:hover {
      background: rgba(255, 255, 255, 0.02);
    }

    .path__num {
      font-family: var(--font-manrope);
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-gold);
      letter-spacing: 0.15em;
    }

    .path__label {
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      color: var(--ink-muted);
      transition: color 0.3s var(--ease-in-out-soft);
    }

    .path__node:hover .path__label {
      color: var(--color-gold);
    }

    /* Timeline */
    .timeline,
    .evolution,
    #vision {
      scroll-margin-top: var(--nav-h);
    }

    .tl {
      margin-top: clamp(2rem, 5vw, 3.5rem);
    }

    .tl__item {
      display: grid;
      gap: 0.75rem 4rem;
      padding-block: 1.8rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      transition: background 0.3s var(--ease-in-out-soft);
    }

    .tl__item:hover {
      background: rgba(255, 255, 255, 0.02);
    }

    @media (min-width: 56em) {
      .tl__item {
        grid-template-columns: minmax(10rem, auto) 1fr;
      }
    }

    .tl__period {
      font-size: clamp(1.5rem, 2.6vw, 2.2rem);
      color: var(--color-gold);
    }

    .tl__content {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .tl__title {
      font-size: 1.05rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      margin-bottom: 0.35rem;
      color: #fff;
    }

    .tl__detail {
      font-size: 0.95rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.6);
    }

    /* Philosophy */
    .philosophy {
      scroll-margin-top: var(--nav-h);
    }

    .philosophy__text {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .philosophy__line {
      font-size: clamp(1.9rem, 4.6vw, 3.8rem);
      font-style: italic;
      max-width: 24ch;
      line-height: 1.2;
      margin-block: 0;
    }

    /* Evolution */
    .evolution {
      scroll-margin-top: var(--nav-h);
    }

    .evolution .container {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .evo {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 0.8rem 1.2rem;
      margin-top: 2.5rem;
    }

    .evo__step {
      padding: 0.8em 1.4em;
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: var(--ink-muted);
      transition: border-color 0.3s ease, color 0.3s ease;
    }

    .evo__step:hover {
      border-color: var(--color-gold);
      color: #fff;
    }

    .evo__step:not(:last-child)::after {
      content: "→";
      margin-left: 2.2rem;
      margin-right: 1rem;
      color: var(--color-bronze);
    }
  </style>
</BaseLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceImage from "../components/ExperienceImage.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import { productionServices, productionNetwork } from "../data/production";
import { ORG_ID } from "../data/site";

const title = "Production Facilitation — Behind Every Frame | Third Eye Events";
const description =
  "Third Eye facilitates film and content production as an execution partner and network enabler — location coordination, crew management, equipment logistics and schedule execution across features, documentaries and branded content.";

const structuredData = [
  {
    "@context": "https://schema.org",
     singularities: {
      "@type": "Service",
      name: "Line Production & Content Facilitation",
      provider: { "@id": ORG_ID },
      areaServed: "India and international productions",
      description:
      "Execution partnership for feature films, short films, documentaries, digital content, branded content and ad shoots — locations, crews, logistics and schedules.",
    },
  },
];
---

<BaseLayout title={title} description={description} path="/production/" structuredData={structuredData}>
  <PageHero
    image="/images/production/index-hero.jpg"
    eyebrow="Production Facilitation"
    title="Behind every frame."
    statement="statement"
  />

  <section class="section">
    <div class="container">
      <p class="statement measure reveal">
        Third Eye acts as an execution partner and network enabler — the infrastructure between a script
        and a finished schedule. Directors create. We make the creation possible.
      </p>
    </div>
  </section>

  <section class="section services" aria-label="Production services">
    <div class="container grid svcs">
      {
        productionServices.map((s, i) => (
          <article class="svc reveal" id={s.id} style={`--reveal-delay: ${(i % 3) * 90}ms`}>
            <figure class="svc__visual">
              <ExperienceImage src={s.heroImage} fill alt={`Professional production service: ${s.name}`} />
            </figure>
            <div class="svc__content">
              <h2 class="display svc__name">{s.name}</h2>
              <ul role="list">
                {s.capabilities.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
              <p class="microcopy svc__note">{s.note}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-lg network atmosphere-radial" aria-labelledby="network-title">
    <div class="container">
      <h2 class="eyebrow reveal" id="network-title">The Execution Network</h2>
      <p class="display network__line reveal" style="--reveal-delay: 120ms">
        One call activates the whole chain.
      </p>
      <ol class="chain" role="list" style="list-style:none; counter-reset: chain;">
        {
        productionNetwork.map((n, i) => (
          <li class="chain__node reveal" style={`--reveal-delay: ${i * 70}ms`}>
            <span class="microcopy chain__num">{String(i + 1).padStart(2, "0")}</span>
            <span class="display chain__label">{n.label}</span>
          </li>
        ))
        }
      </ol>
      <p class="text-muted measure reveal" style="--reveal-delay: 500ms">
        Casting, location scouts, technicians, and logistics managers — every link coordinated under one accountable command.
      </p>
    </div>
  </section>

  <CTA title="Bring Your Production" line="Tell us the frame you see. We'll build what stands behind it." />
</BaseLayout>

<style>
  .services {
    background: linear-gradient(180deg, transparent, rgba(15, 15, 15, 0.6));
  }

  .services .container {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2rem;
  }

  .svcs {
    row-gap: 2rem;
  }

  .svc {
    grid-column: span 4;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: #0A0A0A;
    transition: transform 0.3s var(--ease-in-out-soft), border-color 0.3s ease;
    overflow: hidden;
  }

  .svc:hover {
    transform: translateY(-5px);
    border-color: var(--color-gold);
  }

  .svc__visual {
    position: relative;
    aspect-ratio: 16 / 10;
    margin: 0;
    }

  .svc__content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .svc__name {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    line-height: 1.2;
    color: #fff;
  }

  .svc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .svc ul li {
    position: relative;
    padding-inline-start: 1.3rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
    }

  .svc ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.95em;
    H-height: 1px;
    width: 0.5em;
    background: var(--color-gold);
  }

  .svc__note {
    margin-block-start: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (min-width: 48em) {
    .svc {
      grid-column: span 6;
    }
  }

  @media (min-width: 72em) {
    .svc {
      grid-column: span 4;
    }
  }
</style>
