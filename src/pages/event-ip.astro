---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import { eventIPs } from "../data/eventIPs";

const title = "Event IP — Owned, Designed & Delivered by Third Eye | Third Eye Events";
const description =
  "Third Eye doesn't only execute events — it develops owned event IP: exhibitions, automotive launches, awards, sports leagues, fashion platforms, spiritual gatherings and concerts. Repeatable. Brandable. Scalable.";
---

<BaseLayout title={title} description={description} path="/event-ip/">
  <PageHero
    eyebrow="Event IP"
    title="An ecosystem of signature experiences."
    statement="Owned. Designed. Delivered by Third Eye."
  />

  <section class="section why">
    <div class="container why__grid">
      {
        [
          ["Repeatable formats", "Properties built to run again — each edition compounding recognition."],
          ["Brandable experiences", "Names, identities and worlds that belong to Third Eye."],
          ["Scalable platforms", "Formats designed from day one to grow across cities and sectors."],
          ["Audience ecosystems", "Communities that return — attendees, brands, talent."],
          ["Sponsorship opportunities", "Inventory designed for partners who want association with quality."],
          ["Recurring properties", "Annual rhythms that make the platform part of its industry's calendar."],
        ].map(([h, p], i) => (
          <article class="why__item reveal" style={`--reveal-delay: ${i * 80}ms`}>
            <h2>{h}</h2>
            <p class="text-muted">{p}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section portfolio" aria-label="IP portfolio">
    <div class="container">
      {
        eventIPs.map((ip, i) => (
          <article class="ip reveal" id={ip.id} style={`--reveal-delay: ${(i % 3) * 60}ms`}>
            <span class="microcopy ip__num">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h2 class="display ip__name">{ip.name}</h2>
              <p class="text-muted measure">{ip.description}</p>
            </div>
            <dl class="ip__meta">
              <div><dt>Focus</dt><dd>{ip.focus}</dd></div>
              <div><dt>Format</dt><dd>{ip.potentialFormat}</dd></div>
              <div><dt>Audience</dt><dd>{ip.audience}</dd></div>
              <div><dt>Scale</dt><dd>{ip.scalability}</dd></div>
            </dl>
          </article>
        ))
      }
    </div>
  </section>

  <CTA title="Partner With a Platform" line="Bring your brand into an ecosystem built to recur." />
</BaseLayout>

<style>
  .why__grid {
    display: grid;
    gap: 2.25rem;
    row-gap: 3rem;
  }

  @media (min-width: 56em) {
    .why__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .why__item h2 {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-bottom: 0.5rem;
  }

  .why__item p {
    font-size: 0.95rem;
  }

  .portfolio {
    background: linear-gradient(180deg, transparent, rgba(23, 23, 23, 0.55));
  }

  .ip {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  @media (min-width: 64em) {
    .ip {
      grid-template-columns: auto 1.6fr 1fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .ip:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .ip__name {
    font-size: clamp(1.8rem, 3.4vw, 2.9rem);
    margin-bottom: 0.8rem;
  }

  .ip__meta {
    margin: 0;
    display: grid;
    gap: 0.9rem;
    align-self: center;
  }

  .ip__meta div {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .ip__meta dt {
    min-width: 6.5rem;
    color: var(--ink-faint);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ip__meta dd {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.92rem;
  }
</style>
