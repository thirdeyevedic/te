---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "This Experience Does Not Exist Here | Third Eye Events";
const description = "The page you are looking for does not exist. Return to the world of Third Eye.";
---

<BaseLayout title={title} description={description} path="/404" solidNav>
  <section class="nf section-lg">
    <div class="container nf__inner">
      <p class="display nf__om" aria-hidden="true">ॐ</p>
      <h1 class="display nf__title">This experience<br />does not exist here.</h1>
      <p class="statement">Perhaps it exists somewhere else — or is yet to be created with you.</p>
      <div class="nf__actions">
        <a class="btn btn--solid" href="/">Return to Third Eye</a>
        <a class="btn btn--ghost" href="/weddings/">Explore Weddings</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-items: center;
  }

  .nf__inner {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    text-align: left;
  }

  .nf__om {
    font-size: clamp(4rem, 10vw, 8rem);
    color: transparent;
    -webkit-text-stroke: 1px rgba(184, 155, 94, 0.4);
    line-height: 1;
  }

  .nf__title {
    font-size: clamp(2.4rem, 6vw, 4.6rem);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
</style>
