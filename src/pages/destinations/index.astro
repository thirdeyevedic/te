---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CTA from "../../components/CTA.astro";
import { destinations } from "../../data/destinations";

const title = "Destination Weddings — Explore the World of Third Eye | Third Eye Events";
const description =
  "Seven destination worlds for Vaidik weddings — Maldives, Rajasthan, Switzerland, Kyoto, Italy, Bali and voyages at sea. Each designed as an experience, not a location.";
---

<BaseLayout title={title} description={description} path="/destinations/">
  <PageHero
    eyebrow="Destinations"
    title="Different worlds. One standard."
    statement="Every destination is an experience system — landscape, culture, concept and ritual, composed together."
  />

  <section class="section">
    <div class="container grid worlds">
      {
        destinations.map((d, i) => (
          <a
            class={`world ph reveal`}
            href={`/destinations/${d.slug}/`}
            style={`--reveal-delay: ${(i % 3) * 110}ms; view-transition-name: dest-${d.slug}`}
          >
            <span class="microcopy">{d.region}</span>
            <h2 class="display world__name">{d.name}</h2>
            <p class="statement world__tagline">{d.tagline}</p>
            <span class="link-line">Enter Experience</span>
          </a>
        ))
      }
    </div>
  </section>

  <CTA title="Your World Awaits" />
</BaseLayout>

<style>
  .worlds {
    row-gap: 1.25rem;
  }

  .world {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-height: clamp(18rem, 40vh, 26rem);
    padding: 1.9rem;
    border: 1px solid transparent;
    transition: border-color var(--dur-standard) ease;
  }

  .world:hover {
    border-color: var(--color-gold);
  }

  @media (min-width: 48em) {
    .world {
      grid-column: span 8;
    }
  }

  @media (min-width: 72em) {
    .world {
      grid-column: span 4;
    }
  }

  .world__name {
    font-size: clamp(2.1rem, 3.4vw, 3rem);
    margin-block-start: auto;
  }

  .world__tagline {
    font-size: 1rem;
  }
</style>
