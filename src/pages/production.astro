---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import { productionServices, productionNetwork } from "../data/production";
import { ORG_ID } from "../data/site";

const title = "Production Facilitation — Behind Every Frame | Third Eye Events";
const description =
  "Third Eye facilitates film and content production as an execution partner and network enabler — location coordination, crew management, equipment logistics and schedule execution across features, documentaries and branded content.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Line Production & Content Facilitation",
    provider: { "@id": ORG_ID },
    areaServed: "India and international productions",
    description:
      "Execution partnership for feature films, short films, documentaries, digital content, branded content and ad shoots — locations, crews, logistics and schedules.",
  },
];
---

<BaseLayout title={title} description={description} path="/production/" structuredData={structuredData}>
  <PageHero
    image="/images/production/index-hero.jpg"
    eyebrow="Production Facilitation"
    title="Behind every frame."
    statement="Structured. Managed. Delivered by Third Eye."
  />

  <section class="section">
    <div class="container">
      <p class="statement measure reveal">
        Third Eye acts as an execution partner and network enabler — the infrastructure between a script
        and a finished schedule. Directors create. We make the creation possible.
      </p>
    </div>
  </section>

  <section class="section services" aria-label="Production services">
    <div class="container grid svcs">
      {
        productionServices.map((s, i) => (
          <article class="svc reveal" id={s.id} style={`--reveal-delay: ${(i % 3) * 90}ms`}>
            <figure class="svc__visual">
              <img src={s.heroImage} alt="" class="xi__media xi--fill" loading="lazy" decoding="async" />
            </figure>
            <h2 class="display svc__name">{s.name}</h2>
            <ul role="list">
              {s.capabilities.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
            <p class="microcopy svc__note">{s.note}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-lg network atmosphere-radial" aria-labelledby="network-title">
    <div class="container">
      <h2 class="eyebrow reveal" id="network-title">The Execution Network</h2>
      <p class="display network__line reveal" style="--reveal-delay: 120ms">
        One call activates the whole chain.
      </p>
      <ol class="chain" role="list" style="list-style:none; counter-reset: chain;">
        {
          productionNetwork.map((n, i) => (
            <li class="chain__node reveal" style={`--reveal-delay: ${i * 70}ms`}>
              <span class="microcopy">{String(i + 1).padStart(2, "0")}</span>
              <span class="display chain__label">{n.label}</span>
            </li>
          ))
        }
      </ol>
      <p class="text-muted measure reveal" style="--reveal-delay: 500ms">
        From the first scout to the final wrap — every link coordinated under one accountable command.
      </p>
    </div>
  </section>

  <CTA title="Bring Your Production" line="Tell us the frame you see. We'll build what stands behind it." />
</BaseLayout>

<style>
  .services {
    background: linear-gradient(180deg, transparent, rgba(23, 23, 23, 0.55));
  }

  .svcs {
    row-gap: 2rem;
  }

  .svc__visual {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin: -1.75rem -1.75rem 0;
  }

  .svc {
    grid-column: span 4;
    padding: 1.75rem;
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  @media (min-width: 48em) {
    .svc {
      grid-column: span 8;
    }
  }

  @media (min-width: 72em) {
    .svc {
      grid-column: span 4;
    }
  }

  .svc__name {
    font-size: clamp(1.45rem, 2.2vw, 1.9rem);
  }

  .svc ul li {
    position: relative;
    padding-inline-start: 1.3rem;
    color: var(--ink-muted);
    font-size: 0.92rem;
    padding-block: 0.22rem;
  }

  .svc ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.95em;
    width: 0.5em;
    height: 1px;
    background: var(--color-gold);
  }

  .svc__note {
    margin-block-start: auto;
  }

  /* Network */
  .network__line {
    font-size: clamp(2rem, 5vw, 3.8rem);
    margin-block: 1.4rem 3rem;
  }

  .chain {
    margin-bottom: 3rem;
  }

  .chain__node {
    display: flex;
    align-items: baseline;
    gap: 2rem;
    padding-block: 1.3rem;
    border-bottom: 1px solid var(--line);
  }

  .chain__node:first-child {
    border-top: 1px solid var(--line);
  }

  .chain__label {
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    color: var(--ink-muted);
    transition: color var(--dur-micro) ease;
  }

  .chain__node:hover .chain__label {
    color: var(--color-gold);
  }
</style>
