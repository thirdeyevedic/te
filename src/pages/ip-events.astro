---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceImage from "../components/ExperienceImage.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import { ipEvents } from "../data/ipEvents";

const title = "Third Eye IP Events — Owned, Designed & Delivered | Third Eye Events";
const description =
  "Third Eye doesn't only execute events — it develops owned IP Events: exhibitions, automotive launches, awards, sports leagues, fashion platforms, spiritual gatherings and concerts. Repeatable. Brandable. Scalable.";
---

<BaseLayout title={title} description={description} path="/ip-events/">
  <PageHero
    image="/images/ip/index-hero.jpg"
    eyebrow="Third Eye IP Events"
    title="An ecosystem of signature experiences."
    statement="Owned. Designed. Delivered by Third Eye."
  />

  <section class="section why">
    <div class="container why__grid">
      {
        [
          ["Repeatable formats", "Properties built to run again — each edition compounding recognition."],
          ["Brandable experiences", "Names, identities and worlds that belong to Third Eye."],
          ["Scalable platforms", "Formats designed from day one to grow across cities and sectors."],
          ["Audience ecosystems", "Communities that return — attendees, brands, talent."],
          ["Sponsorship opportunities", "Inventory designed for partners who want association with quality."],
          ["Recurring properties", "Annual rhythms that make the platform part of its industry's calendar."],
        ].map(([h, p], i) => (
          <article class="why__item reveal" style={`--reveal-delay: ${i * 80}ms`}>
            <h2 class="display-small">{h}</h2>
            <p class="text-muted">{p}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section portfolio" aria-label="IP portfolio">
    <div class="container">
      {
        ipEvents.map((ip, i) => (
          <a 
            class="ip reveal" 
            href={`/ip-events/${ip.id}`} 
            id={ip.id} 
            style={`--reveal-delay: ${(i % 3) * 60}ms`}
          >
            <div class="ip__visual-wrapper">
              <figure class="ip__visual">
                <ExperienceImage src={ip.heroImage} fill alt={`High-impact visual for ${ip.name}`} />
                <span class="ph__scrim" aria-hidden="true" />
              </figure>
            </div>
            
            <div class="ip__main">
              <span class="microcopy ip__num">{String(i + 1).padStart(2, "0")}</span>
              <h2 class="display ip__name">{ip.name}</h2>
              <p class="text-muted measure ip__description">{ip.description}</p>
            </div>
            
            <div class="ip__details">
              <dl class="ip__meta">
                <div class="meta-row">
                  <dt>Focus</dt>
                  <dd>{ip.focus}</dd>
                </div>
                <div class="meta-row">
                  <dt>Format</dt>
                  <dd>{ip.potentialFormat}</dd>
                </div>
                <div class="meta-row">
                  <dt>Audience</dt>
                  <dd>{ip.audience}</dd>
                </div>
                <div class="meta-row">
                  <dt>Scale</dt>
                  <dd>{ip.scalability}</dd>
                </div>
              </dl>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <CTA title="Partner With a Platform" line="Bring your brand into an ecosystem built to recur." />
</BaseLayout>

<style>
  .why__grid {
    display: grid;
    gap: 2.5rem;
    row-gap: 4rem;
  }

  @media (min-width: 56em) {
    .why__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .why__item {
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .why__item h2 {
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
    color: #fff;
  }

  .why__item p {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
  }

  .portfolio {
    background: linear-gradient(180deg, transparent, rgba(15, 15, 15, 0.6));
    padding-block: 4rem 0;
  }

  .ip {
    display: grid;
    gap: 2rem;
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: calc(var(--nav-h) + 1rem);
    transition: background 0.4s var(--ease-in-out-soft);
    text-decoration: none;
    color: inherit;
  }

  .ip:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .ip:last-of-type {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .ip__visual-wrapper {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    pointer-events: none;
  }

  .ip__visual {
    position: relative;
    aspect-ratio: 21 / 9;
    margin: 0;
    overflow: hidden;
    transition: transform 0.8s var(--ease-in-out-soft);
  }

  .ip:hover .ip__visual {
    transform: scale(1.05);
  }

  @media (min-width: 48em) {
    .ip__visual {
      aspect-ratio: 16 / 5;
    }
  }

  .ip__main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
    z-index: 2;
  }

  .ip__num {
    font-family: var(--font-manrope);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-gold);
    letter-spacing: 0.15em;
    margin-bottom: 0.5rem;
  }

  .ip__name {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin-bottom: 1rem;
    line-height: 1.1;
    color: #fff;
  }

  .ip__description {
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    max-width: 600px;
  }

  .ip__details {
    display: flex;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .ip__meta {
    margin: 0;
    display: grid;
    gap: 1.2rem;
    width: 100%;
  }

  .meta-row {
    display: flex;
    gap: 1.5rem;
    align-items: baseline;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    padding-bottom: 0.4rem;
  }

  .meta-row dt {
    min-width: 7rem;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-family: var(--font-manrope);
    font-weight: 600;
  }

  .meta-row dd {
    margin: 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.95rem;
    font-family: var(--font-manrope);
  }

  @media (min-width: 64em) {
    .ip {
      grid-template-columns: 1.4fr 1.2fr 1fr;
      gap: 5rem;
      align-items: start;
    }
    
    .ip__details {
      position: sticky;
      top: calc(var(--nav-h) + 2rem);
    }
  }
</style>
