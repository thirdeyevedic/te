---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CTA from "../../components/CTA.astro";
import { conceptFamilies } from "../../data/concepts";

const title = "Wedding Worlds — Concepts That Create Emotion | Third Eye Events";
const description =
  "Rajsi, Prakriti, Nakshatra, Agni-Him — Third Eye wedding concepts are designed around meaning. Explore six semantic families: Royal, Nature, Elemental, Cosmic, Spiritual and Journey.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Third Eye Wedding Concepts",
    itemListElement: conceptFamilies.flatMap((f) =>
      f.concepts.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: { "@type": "Thing", name: c.name, description: c.meaning },
      })),
    ),
  },
];
---

<BaseLayout title={title} description={description} path="/weddings/concepts/" structuredData={structuredData}>
  <PageHero
    eyebrow="Weddings · Concepts"
    title="Wedding Worlds"
    statement="Locations are common. Concepts create emotion."
  />

  <section class="section families">
    <div class="container">
      {
        conceptFamilies.map((family) => (
          <article class="family reveal" id={family.id}>
            <header class="family__head">
              <h2 class="display family__name">{family.family}</h2>
              <p class="statement family__essence">{family.essence}</p>
            </header>
            <ul role="list" class="family__list">
              {family.concepts.map((c) => (
                <li>
                  <h3 class="concept__name">{c.name}</h3>
                  <p class="text-muted concept__meaning">{c.meaning}</p>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <CTA title="Design Your World" line="Tell us the emotion you're chasing. The concept follows." />

  <style>
    .family {
      padding-block: clamp(3rem, 7vw, 5rem);
      border-top: 1px solid var(--line);
    }

    .family:last-of-type {
      border-bottom: 1px solid var(--line);
    }

    .family__head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.75rem 3rem;
      margin-bottom: clamp(2rem, 5vw, 3.5rem);
    }

    .family__name {
      font-size: clamp(2.4rem, 6vw, 4.8rem);
      color: transparent;
      -webkit-text-stroke: 1px rgba(184, 155, 94, 0.45);
      background: linear-gradient(180deg, rgba(184, 155, 94, 0.22), rgba(169, 85, 43, 0.08));
      -webkit-background-clip: text;
      background-clip: text;
    }

    .family__essence {
      max-width: 34ch;
      font-size: 1.05rem;
    }

    .family__list {
      display: grid;
      gap: 1rem 3rem;
    }

    @media (min-width: 56em) {
      .family__list {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 72em) {
      .family__list {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .family__list li {
      border-top: 1px solid rgba(245, 241, 232, 0.07);
      padding-block: 1.1rem;
    }

    .concept__name {
      font-size: 1.15rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--color-gold);
      margin-bottom: 0.35rem;
    }

    .concept__meaning {
      font-size: 0.92rem;
      line-height: 1.6;
    }
  </style>
</BaseLayout>
