---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import CTA from "../../../components/CTA.astro";
import { signatureEntries } from "../../../data/signatureEntries";

const title = "Signature Entries — Moments That Define the Wedding | Third Eye Events";
const description =
  "The Shiva Entry, Royal Entry, Floral Entry and Celestial Entry — Third Eye signature experiences that define the wedding before it begins.";

const entriesJSON = JSON.stringify(signatureEntries.map((e) => ({
  slug: e.slug,
  category: e.category,
  title: e.title,
  line: e.line,
  descriptor: e.descriptor,
  sound: e.sound,
  targetAudience: e.targetAudience,
  customizationOptions: e.customizationOptions,
})));
---

<BaseLayout title={title} description={description} path="/weddings/experiences/">
    <PageHero
      image="/images/weddings/experiences-hero.jpg"
      eyebrow="Weddings · Signature Experiences"
      title="Moments that define the wedding before it begins."
      statement="An entry is not a walk. It is the first sentence of the story your guests will retell."
    />

    <!-- Micro-CTA Header -->
    <div class="container">
      <p class="text-center text-micro mb-6">
        Choose the moment that defines your beginning.
      </p>
    </div>

    <!-- Signature Entries Container -->
    <section class="section">
      <div class="signature-entries">
        <div class="signature-entries__track">
          {signatureEntries.map((entry, index) => (
            <button
              class="signature-entries__card sig ph reveal"
              data-entry={entry.slug}
              style={`--reveal-delay: ${index * 110}ms; view-transition-name: entry-${entry.slug}`}
              aria-label={`Explore ${entry.title}`}
            >
              {/* Visual/Image */}
              {entry.heroImage && (
                <div class="signature-entries__visual">
                  <img 
                    src={entry.heroImage} 
                    alt={`${entry.title} hero image`}
                    class="signature-entries__image"
                    loading="lazy"
                  />
                </div>
              )}

              {/* Content */}
              <div class="signature-entries__content">
                <span class="signature-entries__category microcopy">{entry.category}</span>
                <h2 class="signature-entries__title display sig__title">{entry.title}</h2>
                <p class="signature-entries__line statement sig__line">{entry.line}</p>
              </div>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="section sig-line">
      <div class="container">
        <p class="statement reveal">Before the rituals begin, we create a moment the world will remember.</p>
      </div>
    </section>

    <CTA />

<!-- Full-screen expansion dialog -->
    <dialog class="entry-dialog" id="entry-dialog" aria-label="Signature entry detail">
      <div class="entry-dialog__backdrop" id="entry-dialog-backdrop"></div>
      <div class="entry-dialog__content">
        <button class="entry-dialog__close" id="entry-dialog-close" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
        <div class="entry-dialog__inner">
          {/* Video Container (for cinematic video playback) */}
          <div class="entry-dialog__video-container" id="dialog-video-container">
            {/* Video will be inserted here when available */}
            {/* Example: <video src="/videos/shiva-entry-cinematic.mp4" autoplay muted loop playsinline></video> */}
          </div>
          
          <div class="entry-dialog__info">
            <p class="microcopy entry-dialog__category" id="dialog-category"></p>
            <h2 class="display entry-dialog__title" id="dialog-title"></h2>
            <p class="statement entry-dialog__line" id="dialog-line"></p>
            <p class="text-muted entry-dialog__descriptor" id="dialog-descriptor"></p>

            <div class="entry-dialog__meta">
              <div class="entry-dialog__sound">
                <p class="eyebrow">Sound Identity</p>
                <p class="text-muted" id="dialog-sound"></p>
                {/* Revealed by the script only when the entry actually ships an
                    audio asset. `entriesJSON` carries no `audioUrl` until the
                    file exists, so today this stays hidden rather than sitting
                    there as a control that does nothing when pressed. */}
                <button
                  class="btn btn--ghost btn--small"
                  id="dialog-sound-toggle"
                  aria-label="Play sound identity"
                  hidden
                >
                  <span id="dialog-sound-icon" aria-hidden="true">▶️</span>
                </button>
              </div>
              <div class="entry-dialog__audience">
                <p class="eyebrow">Who This Is For</p>
                <p class="text-muted" id="dialog-audience"></p>
              </div>
            </div>

            <div class="entry-dialog__custom">
              <p class="eyebrow">Customization Options</p>
              <ul role="list" id="dialog-custom"></ul>
            </div>

            <div class="entry-dialog__actions">
              <a class="btn btn--solid" id="dialog-cta" href="/contact/">Book This Experience</a>
              <a class="btn btn--ghost" id="dialog-detail" href="#">View Full Sequence</a>
            </div>
          </div>
        </div>
      </div>
    </dialog>

<script>
    const entries = JSON.parse(document.getElementById("entries-data")?.textContent || "[]");
    let cleanupFns: (() => void)[] = [];
    let videoElements: HTMLVideoElement[] = [];
    let audioElements: HTMLAudioElement[] = [];

    /* ── Auto-advance ──────────────────────────────────────────────────────
       The entries drift slowly sideways once the visitor has been idle for
       AUTO_SCROLL_DELAY. WCAG 2.2.2 requires moving content to be stoppable,
       so the drift halts while the pointer is over the track, while keyboard
       focus is inside it, and while the tab is hidden — and never starts at
       all under `prefers-reduced-motion`.

       This state lives at module scope rather than inside initExperiences()
       so that a drift left running by a previous page instance can always be
       cancelled: reading a function-local `let` from the top of
       initExperiences() would hit the temporal dead zone. */
    let signatureTrack: HTMLElement | null = null;
    let autoScrollTimer: number | null = null;
    let autoScrollFrame: number | null = null;
    let autoScrollPaused = false;

    const AUTO_SCROLL_DELAY = 5000; // idle ms before the drift begins
    const AUTO_SCROLL_SPEED = 0.5; // px per frame — deliberately slow

    const prefersReducedMotion = () =>
      matchMedia("(prefers-reduced-motion: reduce)").matches;

    function cancelAutoScroll() {
      if (autoScrollTimer !== null) {
        clearTimeout(autoScrollTimer);
        autoScrollTimer = null;
      }
      if (autoScrollFrame !== null) {
        cancelAnimationFrame(autoScrollFrame);
        autoScrollFrame = null;
      }
    }

    /** Suspend the stylesheet's scroll snapping and smooth behaviour while the
        drift is actually moving.
        `.signature-entries__track` sets `scroll-snap-type: x mandatory`, which
        re-aligns the track to a card after *every* scroll — so a 0.5px nudge is
        undone on the very next frame and the drift can never move at all. The
        track also sets `scroll-behavior: smooth`, which would animate each
        sub-pixel step instead of applying it.
        Snapping is handed back the moment the visitor takes over (see the
        user-input binding), so their own flicks still land card-aligned. */
    function setDriftMode(active: boolean) {
      if (!signatureTrack?.isConnected) return;
      signatureTrack.style.scrollSnapType = active ? "none" : "";
      signatureTrack.style.scrollBehavior = active ? "auto" : "";
    }

    /** Cancel the drift and hand scroll behaviour back to the stylesheet. */
    function stopAutoScroll() {
      cancelAutoScroll();
      setDriftMode(false);
    }

    function autoScrollStep() {
      autoScrollFrame = null;
      if (autoScrollPaused || !signatureTrack) return;
      /* Stop at the last entry instead of looping — a hard jump back to the
         start reads as a glitch rather than as a gesture. */
      const atEnd =
        signatureTrack.scrollLeft + signatureTrack.clientWidth >=
        signatureTrack.scrollWidth - 1;
      if (atEnd) return;
      setDriftMode(true);
      signatureTrack.scrollLeft += AUTO_SCROLL_SPEED;
      autoScrollFrame = requestAnimationFrame(autoScrollStep);
    }

    function startAutoScroll() {
      cancelAutoScroll();
      if (autoScrollPaused || !signatureTrack) return;
      if (prefersReducedMotion()) return;
      autoScrollTimer = window.setTimeout(autoScrollStep, AUTO_SCROLL_DELAY);
    }

    /* Pausing deliberately leaves snapping suspended: re-enabling
       `scroll-snap-type` mid-track would yank the visitor's view sideways to
       the nearest card the instant they hovered. Snapping comes back only on
       real input, or when the page tears the drift down. */
    function pauseAutoScroll() {
      autoScrollPaused = true;
      cancelAutoScroll();
    }

    function resumeAutoScroll() {
      autoScrollPaused = false;
      startAutoScroll();
    }

    /** The visitor has taken over: restore card snapping, then re-arm the idle
        countdown so the drift can pick up again once they stop. */
    function handBackToUser() {
      setDriftMode(false);
      startAutoScroll();
    }

    function initExperiences() {
      cleanupFns.forEach((fn) => fn());
      cleanupFns = [];

      /* Drop the previous page instance's track and drift before resolving
         the new DOM. */
      signatureTrack = null;
      stopAutoScroll();

      // Stop any playing videos and audio
      videoElements.forEach(video => {
        video.pause();
        video.currentTime = 0;
      });
      videoElements = [];
      
      audioElements.forEach(audio => {
        audio.pause();
        audio.currentTime = 0;
      });
      audioElements = [];

      const dialog = document.getElementById("entry-dialog") as HTMLDialogElement;
      const backdrop = document.getElementById("entry-dialog-backdrop");
      const closeBtn = document.getElementById("entry-dialog-close");
      const videoContainer = document.getElementById("dialog-video-container");
      const soundToggleBtn = document.getElementById("dialog-sound-toggle");
      const soundIcon = document.getElementById("dialog-sound-icon");
      signatureTrack = document.querySelector<HTMLElement>(".signature-entries__track");

      if (!dialog || !backdrop || !closeBtn) return;

      function openEntry(slug: string) {
        const entry = entries.find((e: { slug: string }) => e.slug === slug);
        if (!entry) return;

        // Populate basic info
        document.getElementById("dialog-category")!.textContent = entry.category;
        document.getElementById("dialog-title")!.textContent = entry.title;
        document.getElementById("dialog-line")!.textContent = entry.line;
        document.getElementById("dialog-descriptor")!.textContent = entry.descriptor;
        document.getElementById("dialog-sound")!.textContent = entry.sound || 'Curated per celebration';
        document.getElementById("dialog-audience")!.textContent = entry.targetAudience;

        // Populate customization options
        const customList = document.getElementById("dialog-custom")!;
        /* Built as nodes with textContent rather than innerHTML: no HTML
           parsing, so no injection surface even if the data source changes. */
        customList.replaceChildren(
          ...entry.customizationOptions.map((opt: string) => {
            const li = document.createElement("li");
            li.textContent = opt;
            return li;
          }),
        );

        // Set up video if available
        if (videoContainer && entry.videoUrl) {
          // Clear container first
          videoContainer.innerHTML = '';
          
          // Create video element
          const video = document.createElement('video');
          video.src = entry.videoUrl;
          video.autoplay = true;
          video.muted = true; // Start muted for autoplay policies
          video.loop = true;
          video.playsInline = true;
          video.preload = 'auto';
          
          video.addEventListener("loadedmetadata", () => {
            // Video is ready to play
            video.play().catch(() => {
              // Autoplay refused — leave the element paused and unmuted so the
              // visitor can start it themselves.
              video.muted = false;
            });
          });
          
          videoContainer.hidden = false;
          videoContainer.appendChild(video);
          videoElements.push(video);
        } else if (videoContainer) {
          /* No cinematic asset for this entry yet. Hide the slot entirely
             rather than showing developer placeholder copy — "(Video asset
             would be loaded here)" was rendering to visitors. The wiring above
             still activates the moment an entry ships a `videoUrl`. */
          videoContainer.innerHTML = "";
          videoContainer.hidden = true;
        }

        // Set up audio if available
        if (soundToggleBtn && soundIcon && entry.audioUrl) {
          const audio = new Audio(entry.audioUrl);
          audio.loop = true;
          audio.preload = "auto";
          audioElements.push(audio);

          soundToggleBtn.hidden = false;
          let isSoundPlaying = false;

          const toggleSound = () => {
            isSoundPlaying = !isSoundPlaying;
            soundIcon.textContent = isSoundPlaying ? "⏸️" : "▶️";
            soundToggleBtn.setAttribute(
              "aria-label",
              isSoundPlaying ? "Pause sound identity" : "Play sound identity",
            );

            if (!isSoundPlaying) {
              audio.pause();
              return;
            }

            audio.play().catch(() => {
              /* Autoplay policy refused the play — put the control back to
                 "play" so the visitor's next click retries honestly instead of
                 leaving a pause icon on silence. */
              isSoundPlaying = false;
              soundIcon.textContent = "▶️";
              soundToggleBtn.setAttribute("aria-label", "Play sound identity");
            });
          };

          /* One stable reference, bound once per dialog population. The old
             code tried to de-duplicate by string-matching the cleanup
             function's source, which never matched, so every re-open stacked
             another listener on the same button. */
          soundToggleBtn.addEventListener("click", toggleSound);
          cleanupFns.push(() => soundToggleBtn.removeEventListener("click", toggleSound));
        }

        // Update CTA links
        (document.getElementById("dialog-cta") as HTMLAnchorElement).href = '/contact/';
        (document.getElementById("dialog-detail") as HTMLAnchorElement).href = `/weddings/experiences/${slug}/`;

        dialog.showModal();
        document.body.style.overflow = 'hidden';
        // The modal covers the track; hold the drift until it closes.
        pauseAutoScroll();
      }

      function closeDialog() {
        dialog.close();
        document.body.style.overflow = '';

        // Stop videos when closing
        videoElements.forEach(video => {
          video.pause();
          video.currentTime = 0;
        });

        // Stop audio when closing
        audioElements.forEach(audio => {
          audio.pause();
          audio.currentTime = 0;
        });

        // Resume auto-scroll when dialog closes
        resumeAutoScroll();
      }

      const entryBtns = document.querySelectorAll("[data-entry]");
      entryBtns.forEach((btn) => {
        const handler = () => openEntry((btn as HTMLElement).dataset.entry || "");
        btn.addEventListener("click", handler);
        cleanupFns.push(() => btn.removeEventListener("click", handler));
      });

      const closeHandler = () => closeDialog();
      closeBtn.addEventListener("click", closeHandler);
      cleanupFns.push(() => closeBtn.removeEventListener("click", closeHandler));

      backdrop.addEventListener("click", closeHandler);
      cleanupFns.push(() => backdrop.removeEventListener("click", closeHandler));

      const dialogClickHandler = (e: MouseEvent) => {
        if (e.target === dialog) closeDialog();
      };
      dialog.addEventListener("click", dialogClickHandler);
      cleanupFns.push(() => dialog.removeEventListener("click", dialogClickHandler));

      const keydownHandler = (e: KeyboardEvent) => {
        if (e.key === "Escape" && dialog.open) closeDialog();
      };
      document.addEventListener("keydown", keydownHandler);
      cleanupFns.push(() => document.removeEventListener("keydown", keydownHandler));
      
      /* Auto-advance wiring. The state and the drift itself live at module
         scope; this only binds the events that govern it.

         Note `scroll` is deliberately NOT an interaction event: the drift
         moves scrollLeft itself, so treating its own scroll events as user
         input would cancel the drift on its very first frame. Every way a
         visitor can actually scroll the track (pointer, wheel, touch, key)
         is covered below. */
      if (signatureTrack) {
        const track = signatureTrack;
        const bind = <K extends keyof HTMLElementEventMap>(
          type: K,
          handler: (event: HTMLElementEventMap[K]) => void,
        ) => {
          const listener = handler as EventListener;
          track.addEventListener(type, listener, { passive: true });
          cleanupFns.push(() => track.removeEventListener(type, listener));
        };

        // WCAG 2.2.2 — moving content stops while the pointer is over it or
        // keyboard focus is inside it.
        bind("pointerenter", pauseAutoScroll);
        bind("pointerleave", resumeAutoScroll);
        bind("focusin", pauseAutoScroll);
        bind("focusout", resumeAutoScroll);

        // Any deliberate input hands snapping back and restarts the idle
        // countdown.
        (["pointerdown", "wheel", "touchstart", "keydown"] as const).forEach((type) => {
          bind(type, handBackToUser);
        });
      }

      const visibilityHandler = () => {
        if (document.hidden) pauseAutoScroll();
        else resumeAutoScroll();
      };
      document.addEventListener("visibilitychange", visibilityHandler);
      cleanupFns.push(() => document.removeEventListener("visibilitychange", visibilityHandler));

      startAutoScroll();
    }

    document.addEventListener("astro:page-load", initExperiences);
  </script>

  {/* Serialised entry data read by the script above — data, not code. */}
  <script is:inline type="application/json" id="entries-data" set:html={entriesJSON} />

  <style>
    .sigs {
      row-gap: 1.25rem;
    }

    .sig {
      grid-column: span 4;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      min-height: clamp(20rem, 48vh, 28rem);
      padding: 1.9rem;
      border: 1px solid transparent;
      background: none;
      text-align: left;
      cursor: pointer;
      font: inherit;
      color: inherit;
      transition: border-color var(--dur-standard) ease, scale var(--dur-standard) var(--ease-out-expo);
    }

    .sig:hover {
      border-color: var(--color-gold);
      scale: 1.01;
      box-shadow: 0 0 30px rgba(184, 155, 94, 0.1);
    }

    .sig .link-line {
      opacity: 0;
      transition: opacity var(--dur-standard) ease;
    }

    .sig:hover .link-line {
      opacity: 1;
    }

    @media (min-width: 48em) {
      .sig {
        grid-column: span 8;
      }
    }

    @media (min-width: 72em) {
      .sig {
        grid-column: span 6;
      }
    }

    .sig__title {
      font-size: clamp(1.9rem, 3.4vw, 2.8rem);
      margin-block-start: auto;
    }

    .sig__line {
      font-family: var(--font-body);
      font-style: normal;
      font-size: 0.98rem;
    }

    .sig-line {
      text-align: center;
    }

    .sig-line .statement {
      max-width: 32ch;
      margin-inline: auto;
      font-size: clamp(1.05rem, 1.8vw, 1.4rem);
    }

    /* ── Dialog ── */
    .entry-dialog {
      position: fixed;
      inset: 0;
      z-index: 200;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      border: 0;
      padding: 0;
      background: transparent;
      overflow: hidden;
    }

    .entry-dialog::backdrop {
      display: none;
    }

    .entry-dialog__backdrop {
      position: fixed;
      inset: 0;
      background: rgba(10, 10, 10, 0.92);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
    }

    .entry-dialog__content {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      overflow-y: auto;
      display: grid;
      place-items: center;
      padding: clamp(2rem, 5vw, 4rem);
    }

    .entry-dialog__close {
      position: fixed;
      top: 1.5rem;
      right: 1.5rem;
      z-index: 10;
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border: 1px solid var(--line);
      border-radius: 50%;
      color: var(--ink-muted);
      font-size: 1.6rem;
      transition: border-color var(--dur-micro) ease, color var(--dur-micro) ease;
    }

    .entry-dialog__close:hover {
      border-color: var(--color-gold);
      color: var(--color-gold);
    }

    .entry-dialog__inner {
      max-width: 52rem;
      width: 100%;
      display: grid;
      gap: 1.8rem;
      justify-items: start;
      padding-block: clamp(2rem, 6vh, 5rem);
    }

    .entry-dialog__category {
      color: var(--color-gold);
    }

    .entry-dialog__title {
      font-size: clamp(2.6rem, 7vw, 5.5rem);
    }

    .entry-dialog__line {
      font-size: clamp(1.1rem, 2vw, 1.5rem);
    }

    .entry-dialog__descriptor {
      font-size: 1.05rem;
      line-height: 1.75;
      max-width: 48ch;
    }

    /* Two equal columns from 48em up, stacked below it. This was previously
       dead: a later duplicate of this rule set `display: flex`, which silently
       made `grid-template-columns` inert and squeezed both columns side by
       side on phones. */
    .entry-dialog__meta {
      display: grid;
      gap: 2rem;
      width: 100%;
      margin-block: 1.5rem;
      padding-block: 1rem;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    @media (min-width: 48em) {
      .entry-dialog__meta {
        grid-template-columns: 1fr 1fr;
      }
    }

    .entry-dialog__meta .eyebrow {
      margin-bottom: 0.6rem;
    }

    .entry-dialog__custom {
      width: 100%;
      margin-block: 1.5rem;
    }

    .entry-dialog__custom .eyebrow {
      margin-bottom: 1rem;
    }

    /* These <li>s are built by the script, so the selectors must be global.
       Astro's scoped styles compile `#dialog-custom li` into
       `#dialog-custom[data-astro-cid-…] li[data-astro-cid-…]`, and a node
       created with innerHTML never receives that attribute — so every rule
       here silently stopped matching. The list rendered as default
       `list-item`s: no padding, no rules, no gold dash, and black text on a
       near-black background, i.e. invisible. */
    :global(#dialog-custom) {
      display: grid;
      gap: 0;
    }

    :global(#dialog-custom li) {
      display: flex;
      align-items: baseline;
      gap: 1.5rem;
      padding-block: 0.7rem;
      border-bottom: 1px solid var(--line);
      color: var(--ink-muted);
      font-size: 0.95rem;
    }

    :global(#dialog-custom li:first-child) {
      border-top: 1px solid var(--line);
    }

    :global(#dialog-custom li::before) {
      content: "—";
      color: var(--color-gold);
      flex-shrink: 0;
    }

    /* Only rendered when an entry actually ships a cinematic asset; the
       script hides it (and its placeholder styles are gone) otherwise. */
    .entry-dialog__video-container {
      position: relative;
      width: 100%;
      height: 40%;
      background: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      overflow: hidden;
    }

    .entry-dialog__info {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .btn--small {
      padding: 0.5rem 1rem;
      font-size: var(--text-micro);
    }

    .entry-dialog__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
    }

    @media (prefers-reduced-motion: reduce) {
      .entry-dialog__backdrop {
        transition: none;
      }
    }
  </style>

  <style>
    /* Signature Entries Layout */
    .signature-entries {
      position: relative;
      overflow: hidden;
      padding-block: calc(var(--space-section) * 1.5);
      background: var(--bg); /* Black background */
    }

    .signature-entries::before {
      content: "";
      position: absolute;
      inset: 0;
      background: 
        radial-gradient(circle at 50% 50%, rgba(184, 155, 94, 0.03) 0%, transparent 70%),
        repeating-linear-gradient(45deg, transparent, transparent 2px, rgba(184, 155, 94, 0.01) 2px, rgba(184, 155, 94, 0.01) 4px);
      pointer-events: none;
    }

    .signature-entries__track {
      display: flex;
      gap: clamp(2rem, 5vw, 3rem);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      padding-block-end: clamp(3rem, 8vh, 6rem);
      -webkit-overflow-scrolling: touch;
    }

    .signature-entries__track::-webkit-scrollbar {
      display: none;
    }

    .signature-entries__card {
      flex: 0 0 auto;
      width: clamp(26rem, 32vw, 30rem);
      height: clamp(32rem, 45vh, 40rem);
      scroll-snap-align: start;
      position: relative;
      display: flex;
      flex-direction: column;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 0.5rem;
      overflow: hidden;
      transition: 
        border-color var(--dur-standard) ease,
        transform var(--dur-standard) var(--ease-out-expo),
        box-shadow var(--dur-standard) var(--ease-out-expo);
    }

    .signature-entries__card:hover {
      border-color: var(--color-gold);
      transform: translateY(-4px) scale(1.01);
      box-shadow: 0 20px 40px rgba(184, 155, 94, 0.15);
    }

    .signature-entries__visual {
      position: relative;
      height: 45%;
      overflow: hidden;
      background: var(--bg-raised);
    }

    .signature-entries__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
