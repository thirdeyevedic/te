---
/**
 * Custom cursor — dot + trailing ring.
 * Desktop fine-pointers only; disabled under reduced motion.
 */
---

<div class="cursor" id="cursor" aria-hidden="true">
  <div class="cursor__dot"></div>
  <div class="cursor__ring"></div>
</div>

<style>
  .cursor {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    html:not(.reduced-motion) .cursor {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 300;
      pointer-events: none;
      opacity: 0;
      transition: opacity 400ms ease;
    }

    html:not(.reduced-motion) .cursor.is-active {
      opacity: 1;
    }

    .cursor__dot,
    .cursor__ring {
      position: absolute;
      top: 0;
      left: 0;
      border-radius: 50%;
      will-change: transform;
    }

    .cursor__dot {
      width: 5px;
      height: 5px;
      margin: -2.5px 0 0 -2.5px;
      background: var(--color-gold);
    }

    .cursor__ring {
      width: 34px;
      height: 34px;
      margin: -17px 0 0 -17px;
      border: 1px solid rgba(184, 155, 94, 0.55);
      transition:
        width var(--dur-micro) ease,
        height var(--dur-micro) ease,
        margin var(--dur-micro) ease,
        border-color var(--dur-micro) ease,
        opacity var(--dur-micro) ease;
    }

    .cursor.is-hover .cursor__ring {
      width: 52px;
      height: 52px;
      margin: -26px 0 0 -26px;
      border-color: rgba(184, 155, 94, 0.9);
    }

    /* Keep native cursor visible — this is an accent, not a replacement */
  }
</style>

<script>
  const finePointer = matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reducedMotion = document.documentElement.classList.contains("reduced-motion");

  function initCursor() {
    const root = document.getElementById("cursor");
    if (!root || !finePointer || reducedMotion || root.dataset.bound) return;
    root.dataset.bound = "1";

    let x = innerWidth / 2;
    let y = innerHeight / 2;
    let ringX = x;
    let ringY = y;
    let raf = 0;

    const dot = root.querySelector<HTMLElement>(".cursor__dot")!;
    const ring = root.querySelector<HTMLElement>(".cursor__ring")!;

    const render = () => {
      ringX += (x - ringX) * 0.16;
      ringY += (y - ringY) * 0.16;
      dot.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
      raf = requestAnimationFrame(render);
    };

    addEventListener(
      "mousemove",
      (e) => {
        if (!raf) raf = requestAnimationFrame(render);
        root.classList.add("is-active");
        x = e.clientX;
        y = e.clientY;
        const target = e.target as Element | null;
        root.classList.toggle("is-hover", !!target?.closest("a, button"));
      },
      { passive: true },
    );

    document.documentElement.addEventListener("mouseleave", () => {
      root.classList.remove("is-active");
      cancelAnimationFrame(raf);
      raf = 0;
    });
  }

  document.addEventListener("astro:page-load", initCursor);
</script>
