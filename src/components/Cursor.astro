---
/**
 * Cursor — A luxury interaction layer.
 * 
 * Instead of a standard mouse, this provides a "lens" that reacts to 
 * interactive elements, providing a tactile, high-end feel.
 */
---

<div class="custom-cursor" id="cursor-dot"></div>
<div class="custom-cursor-follower" id="cursor-follower">
  <span class="follower-text"></span>
</div>

<style>
  :root {
    --cursor-color: #b89b5e;
    --cursor-size: 8px;
    --follower-size: 40px;
  }

  body {
    cursor: none !important;
  }

  a, button, .interactive, input, select, textarea {
    cursor: none !important;
  }

  .custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--cursor-size);
    height: var(--cursor-size);
    background-color: var(--cursor-color);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transition: transform 0.1s ease-out, opacity 0.3s ease;
  }

  .custom-cursor-follower {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--follower-size);
    height: var(--follower-size);
    border: 1px solid var(--cursor-color);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), 
                width 0.3s var(--ease-in-out-soft), 
                height 0.3s var(--ease-in-out-soft), 
                background-color 0.3s ease, 
                opacity 0.3s ease;
    opacity: 0;
  }

  .follower-text {
    font-family: var(--font-manrope);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cursor-color);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    white-space: nowrap;
  }

  /* Active States */
  .cursor-active .custom-cursor {
    transform: scale(0.5);
    opacity: 0.5;
  }

  .cursor-active .custom-cursor-follower {
    opacity: 1;
    background-color: rgba(184, 155, 94, 0.1);
  }

  .cursor-active .follower-text {
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .custom-cursor, .custom-cursor-follower {
      display: none;
    }
    body, a, button, .interactive, input, select, textarea {
      cursor: auto !important;
    }
  }
</style>

<script>
  function initCursor() {
    const dot = document.getElementById("cursor-dot");
    const follower = document.getElementById("cursor-follower");
    const text = follower?.querySelector(".follower-text");
    
    if (!dot || !follower) return;

    let mouseX = 0;
    let mouseY = 0;
    let dotX = 0;
    let dotY = 0;
    let followerX = 0;
    let followerY = 0;

    window.addEventListener("mousemove", (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    // Smooth animation loop
    function animate() {
      // Dot follows mouse exactly
      dotX += (mouseX - dotX) * 0.2;
      dotY += (mouseY - dotY) * 0.2;
      
      // Follower lags behind for "weighty" feel
      followerX += (mouseX - followerX) * 0.1;
      followerY += (mouseY - followerY) * 0.1;

      dot.style.transform = `translate(${dotX}px, ${dotY}px)`;
      follower.style.transform = `translate(${followerX - (follower.offsetWidth / 2)}px, ${followerY - (follower.offsetHeight / 2)}px)`;

      requestAnimationFrame(animate);
    }
    animate();

    // Interaction detection
    const interactives = document.querySelectorAll("a, button, .interactive");
    
    interactives.forEach(el => {
      el.addEventListener("mouseenter", () => {
        document.body.classList.add("cursor-active");
        
        // Set custom text based on element
        const label = el.getAttribute("data-cursor-text") || 
                      (el.tagName === "A" ? "EXPLORE" : "CLICK");
        if (text) text.textContent = label;
      });
      
      el.addEventListener("mouseleave", () => {
        document.body.classList.remove("cursor-active");
      });
    });
  }

  document.addEventListener("astro:page-load", initCursor);
</script>
