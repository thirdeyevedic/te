---
import { CONTACT_EMAIL } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p class="footer__statement display">Built on vision, discipline and truth.</p>

    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="display footer__logo" aria-label="Third Eye Events — home">Third Eye</a>
        <p class="microcopy">Experience &amp; Execution</p>
      </div>

      <nav aria-label="Footer">
        <h2 class="eyebrow">Explore</h2>
        <ul role="list">
          <li><a href="/weddings/">Weddings</a></li>
          <li><a href="/weddings/experiences/">Experiences</a></li>
          <li><a href="/ip-events/">IP Events</a></li>
          <li><a href="/production/">Production</a></li>
          <li><a href="/about/">About</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow">Contact</h2>
        <ul role="list">
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="eyebrow">Legal</h2>
        <ul role="list">
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/sitemap/">Sitemap</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__base">
      <p class="microcopy">© {year} Third Eye Events · Gautam GS</p>
      <p class="microcopy">Vedic Luxury Weddings · Destination · Concepts · IP Events · Production</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-section) 2.5rem;
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, rgba(23, 23, 23, 0.6));
  }

  .footer__statement {
    font-size: clamp(1.9rem, 4.5vw, 3.6rem);
    max-width: 18ch;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2rem;
    padding-bottom: 4rem;
  }

  @media (min-width: 56em) {
    .footer__grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  .footer__brand {
    grid-column: 1 / -1;
  }

  @media (min-width: 56em) {
    .footer__brand {
      grid-column: auto;
    }
  }

  .footer__logo {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  .footer h2 {
    margin-bottom: 1.25rem;
  }

  .footer li {
    padding-block: 0.35rem;
  }

  .footer a {
    color: var(--ink-muted);
    transition: color var(--dur-micro) ease;
  }

  .footer a:hover {
    color: var(--color-gold);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 1.75rem;
  }
</style>
