---
/**
 * ExperienceImage — single entry point for all site imagery.
 *
 * • Real asset supplied  → optimised responsive image (astro:assets for
 *   imported metadata, native img for /public paths), lazy by default.
 * • Nothing supplied → atmospheric gradient that preserves layout, so a
 *   missing asset degrades quietly instead of breaking the page.
 *
 * `fill` mode absolutely-fills a positioned (.ph) parent — used inside
 * cards and heroes.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src?: string | ImageMetadata;
  alt?: string;
  fill?: boolean;
  eager?: boolean;
  tone?: "default" | "agni";
  class?: string;
  /**
   * Where the crop should centre when filling, e.g. "50% 72%".
   * `fill` uses object-fit: cover, which centres by default — fine when the
   * subject is mid-frame, but a photograph whose subject sits low (a skyline,
   * a table setting) loses it to the top edge of a wide, short container.
   */
  position?: string;
}

const {
  src,
  alt = "",
  fill = false,
  eager = false,
  tone = "default",
  class: className,
  position,
} = Astro.props;

const metaSrc = typeof src === "object" ? src : undefined;
const pathSrc = typeof src === "string" ? src : undefined;

const fillClass = fill ? "xi--fill" : "";
const cls = ["xi__media", fillClass, className].filter(Boolean).join(" ");
const style = position ? `object-position: ${position}` : undefined;
---

{
  metaSrc ? (
    <Image
      src={metaSrc}
      alt={alt}
      widths={[480, 768, 1200, 1600]}
      sizes="(max-width: 48em) 100vw, (max-width: 72em) 80vw, 60vw"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class={cls}
      style={style}
    />
  ) : pathSrc ? (
    <img
      src={pathSrc}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class={cls}
      style={style}
    />
  ) : (
    <div class:list={["ph", "xi", `xi--${tone}`, fillClass]} role="presentation">
      {/* Atmospheric fallback — used only when no asset is supplied */}
      {alt && <span class="sr-only">{alt}</span>}
    </div>
  )
}
