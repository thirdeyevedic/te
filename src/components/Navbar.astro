---
import "../styles/global.css";

interface Props {
  solid?: boolean;
}

const { solid = false } = Astro.props;
---

<nav class="navbar" data-solid={solid}>
  <div class="nav-container">
    <a href="/" class="nav-logo">
      <!-- 820x403 source was 198KB and downloaded on every page for a 102x50
           slot. The sized PNGs are 7.5/22.6/42.8KB; a 2x phone takes the 204. -->
      <img
        src="/images/logo-204.png"
        srcset="/images/logo-102.png 102w, /images/logo-204.png 204w, /images/logo-306.png 306w"
        sizes="102px"
        alt="Third Eye Events"
        width="102"
        height="50"
      />
    </a>

    <!-- data-section = the whole section a link owns. It is wider than href:
         the weddings sub-pages (/weddings/, /weddings/vedic/, /weddings/concepts/,
         /weddings/destination/) belong to "Signature Entries" but are not
         descendants of /weddings/experiences/, so href alone highlighted nothing. -->
    <div class="nav-links">
      <a href="/destinations/" data-section="/destinations/" class="nav-link">Destinations</a>
      <a href="/weddings/experiences/" data-section="/weddings/" class="nav-link">Signature Entries</a>
      <a href="/ip-events/" data-section="/ip-events/" class="nav-link">IP Events</a>
      <a href="/production/" data-section="/production/" class="nav-link">Production</a>
      <a href="/about/" data-section="/about/" class="nav-link">About</a>
      <a href="/contact/" class="nav-cta">Get in Touch</a>
    </div>

    <button class="nav-toggle" aria-label="Toggle Menu" aria-expanded="false" aria-controls="nav-menu">
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>
  </div>

  <div id="nav-menu" class="nav-overlay">
    <div class="overlay-content">
      <div class="overlay-links">
        <a href="/destinations/" data-section="/destinations/" class="overlay-link">Destinations</a>
        <a href="/weddings/experiences/" data-section="/weddings/" class="overlay-link">Signature Entries</a>
        <a href="/ip-events/" data-section="/ip-events/" class="overlay-link">IP Events</a>
        <a href="/production/" data-section="/production/" class="overlay-link">Production</a>
        <a href="/about/" data-section="/about/" class="overlay-link">About</a>
        <a href="/contact/" class="overlay-cta">Get in Touch</a>
      </div>
    </div>
  </div>
</nav>

<script>
  function initNavbar() {
    const toggle = document.querySelector(".nav-toggle");
    const menu = document.querySelector(".nav-overlay");
    const links = document.querySelectorAll(".overlay-link, .overlay-cta");

    if (!toggle || !menu) return;

    function toggleMenu(forceClose = false) {
      // forceClose must CLOSE: the old code computed newState = !false = true,
      // so Escape and link taps re-opened the menu instead of closing it.
      const current = toggle!.getAttribute("aria-expanded") === "true";
      const newState = forceClose ? false : !current;

      toggle!.setAttribute("aria-expanded", String(newState));
      menu!.classList.toggle("is-open", newState);
      // Scroll-lock via html.is-menu-open (CSS lives in global.css). html-level
      // locking coexists with the entry dialog's inline body.style.overflow.
      document.documentElement.classList.toggle("is-menu-open", newState);
      if (newState) {
        // Compensate for the scrollbar vanishing behind the fixed overlay
        document.documentElement.style.setProperty(
          "--scrollbar-comp",
          (window.innerWidth - document.documentElement.clientWidth) + "px",
        );
      } else {
        document.documentElement.style.removeProperty("--scrollbar-comp");
      }

      // Update burger icon state
      toggle!.classList.toggle("is-active", newState);
    }

    toggle.addEventListener("click", () => toggleMenu());

    links.forEach(link => {
      link.addEventListener("click", () => toggleMenu(true));
    });

    // Close on Escape key
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu!.classList.contains("is-open")) {
        toggleMenu(true);
        (toggle as HTMLElement).focus();
      }
    });
  }

  /* The header is transparent over the hero by design — but it must not STAY
     transparent once real content scrolls beneath it: white links over a bright
     photo are unreadable (e.g. the weddings gallery row). `solid` is the
     build-time floor: pages that pass it (404) are always solid; every other
     page switches on scroll. */
  function initNavSolid() {
    const nav = document.querySelector<HTMLElement>(".navbar");
    if (!nav) return;
    // Permanently solid page — nothing to toggle.
    if (nav.getAttribute("data-solid") === "true") return;

    const apply = () => {
      nav.setAttribute("data-solid", window.scrollY > 40 ? "true" : "false");
    };

    // Astro re-runs this module on every ClientRouter swap, so the previous
    // listener must be removed or they accumulate against detached nav nodes.
    const w = window as unknown as { __teNavScroll?: () => void };
    if (w.__teNavScroll) window.removeEventListener("scroll", w.__teNavScroll);
    w.__teNavScroll = apply;
    window.addEventListener("scroll", apply, { passive: true });
    apply();
  }

  /* Mark the section the visitor is in. Without this the nav gives no
     "you are here" signal — the visitor can't tell /weddings/vedic/ from
     /production/ except by reading the page.
     Matching uses data-section (the whole section a link owns), falling back
     to href; both sides are normalised to a single trailing slash so
     /about and /about/ behave the same. */
  function initNavCurrent() {
    const norm = (p: string) => {
      if (!p) return "/";
      return p.endsWith("/") ? p : p + "/";
    };
    const path = norm(location.pathname);
    document
      .querySelectorAll<HTMLAnchorElement>(".nav-link, .overlay-link")
      .forEach((a) => {
        const section = norm(a.dataset.section || a.getAttribute("href") || "");
        if (section === "/") return;
        const isCurrent = path === section || path.startsWith(section);
        if (isCurrent) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      });
  }

  document.addEventListener("astro:page-load", initNavbar);
  document.addEventListener("astro:page-load", initNavSolid);
  document.addEventListener("astro:page-load", initNavCurrent);
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition: background 0.4s var(--ease-in-out-soft), padding 0.4s var(--ease-in-out-soft);
    padding: 1.5rem 0;
  }

  .navbar[data-solid="true"] {
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(12px);
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-logo img {
    display: block;
    transition: opacity 0.3s ease;
  }

  .nav-logo:hover img {
    opacity: 0.8;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: color 0.3s ease;
    position: relative;
  }

  .nav-link:hover {
    color: #fff;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: #c5a059;
    transition: width 0.3s var(--ease-in-out-soft);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Current section — the only "you are here" signal on a 76-page site.
     aria-current drives it, so assistive tech gets the same information. */
  .nav-link[aria-current="page"] {
    color: #fff;
  }

  .nav-link[aria-current="page"]::after {
    width: 100%;
  }

  .nav-cta {
    background: #c5a059;
    color: #000;
    text-decoration: none;
    padding: 0.65rem 1.2rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 2px;
    transition: transform 0.3s var(--ease-in-out-soft), background 0.3s ease;
  }

  .nav-cta:hover {
    background: #d4b57a;
    transform: translateY(-1px);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1100;
    width: 30px;
    height: 20px;
    position: relative;
    padding: 0;
  }

  /* Expand the tap target to ≥44px without changing the visual size */
  .nav-toggle::before {
    content: "";
    position: absolute;
    inset: -12px;
  }

  .burger-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: #fff;
    transition: all 0.4s var(--ease-in-out-soft);
  }

  .burger-line:nth-child(1) { top: 0; }
  .burger-line:nth-child(2) { top: 10px; }
  .burger-line:nth-child(3) { top: 20px; }

  .nav-toggle.is-active .burger-line:nth-child(1) {
    transform: translateY(10px) rotate(45deg);
  }
  .nav-toggle.is-active .burger-line:nth-child(2) {
    opacity: 0;
    transform: translateX(-10px);
  }
  .nav-toggle.is-active .burger-line:nth-child(3) {
    transform: translateY(-10px) rotate(-45deg);
  }

  .nav-overlay {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh; /* avoids mobile dynamic-toolbar jitter; vh fallback above */
    background: #0A0A0A;
    z-index: 1050;
    visibility: hidden;
    opacity: 0;
    transition: visibility 0.4s, opacity 0.5s var(--ease-in-out-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-overlay.is-open {
    visibility: visible;
    opacity: 1;
  }

  .overlay-content {
    text-align: center;
    width: 100%;
    max-width: 600px;
    padding: 0 2rem;
  }

  .overlay-links {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
  }

  .overlay-link {
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    /* 2.5rem broke "Signature Entries" onto two lines at 390px (the widest
       label is now ~340px against 326px of room). Scale with the viewport
       and keep a 1.75rem floor so the menu stays legible on small phones. */
    font-size: clamp(1.75rem, 6.8vw, 2.5rem);
    font-weight: 400;
    transition: color 0.3s ease, transform 0.3s var(--ease-in-out-soft);
    opacity: 0;
    transform: translateY(20px);
  }

  .nav-overlay.is-open .overlay-link {
    animation: slideUp 0.6s var(--ease-in-out-soft) forwards;
  }

  .overlay-link:hover {
    color: #c5a059;
    transform: scale(1.05);
  }

  /* Same "you are here" signal as the desktop bar, so the mobile overlay
     doesn't lose the information the wide nav carries. */
  .overlay-link[aria-current="page"] {
    color: #c5a059;
  }

  .overlay-cta {
    margin-top: 1rem;
    background: #c5a059;
    color: #000;
    text-decoration: none;
    padding: 1rem 2.5rem;
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 2px;
    transition: background 0.3s ease;
    opacity: 0;
    transform: translateY(20px);
  }

  .nav-overlay.is-open .overlay-cta {
    animation: slideUp 0.6s var(--ease-in-out-soft) 0.4s forwards;
  }

  .overlay-cta:hover {
    background: #d4b57a;
  }

  @keyframes slideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 64em) {
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: block;
    }
  }
</style>
