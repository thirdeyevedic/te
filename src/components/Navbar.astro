---
interface Props {
  solid?: boolean;
}

const { solid = false } = Astro.props;

interface NavLink {
  label: string;
  href: string;
  note?: string;
}

interface MenuItem {
  label: string;
  href: string;
  intro: string;
  links: NavLink[];
}

const menu: MenuItem[] = [
  {
    label: "Weddings",
    href: "/weddings/",
    intro: "Where celebration becomes experience.",
    links: [
      { label: "Vaidik Weddings", href: "/weddings/vaidik/", note: "Sacred. Pure. Conscious." },
      { label: "Destination Weddings", href: "/weddings/destination/", note: "Different destinations. Different worlds." },
      { label: "Wedding Concepts", href: "/weddings/concepts/", note: "Locations are common. Concepts create emotion." },
      { label: "Signature Entries", href: "/weddings/experiences/", note: "Moments that define the wedding before it begins." },
    ],
  },
  {
    label: "Event IP",
    href: "/event-ip/",
    intro: "An ecosystem of signature experiences — owned, designed and delivered by Third Eye.",
    links: [
      { label: "Exhibitions & Expos", href: "/event-ip/exhibitions/" },
      { label: "Automotive & Mobility", href: "/event-ip/automotive/" },
      { label: "Awards & Gala", href: "/event-ip/awards/" },
      { label: "Best Products of India", href: "/event-ip/products/" },
      { label: "Sports Leagues", href: "/event-ip/sports/" },
      { label: "Fashion & Modeling", href: "/event-ip/fashion/" },
      { label: "Political & Public", href: "/event-ip/political/" },
      { label: "Devotional & Spiritual", href: "/event-ip/devotional/" },
      { label: "Concerts & Live", href: "/event-ip/concerts/" },
    ],
  },
  {
    label: "Production",
    href: "/production/",
    intro: "Behind every frame — structured, managed, delivered.",
    links: [
      { label: "Feature Films", href: "/production/feature-films/" },
      { label: "Short Films", href: "/production/short-films/" },
      { label: "Documentaries", href: "/production/documentaries/" },
      { label: "Digital Content", href: "/production/digital-content/" },
      { label: "Branded Content", href: "/production/branded-content/" },
      { label: "Ad Shoots", href: "/production/ad-shoots/" },
    ],
  },
  {
    label: "About",
    href: "/about/",
    intro: "Not built on events. Built on vision.",
    links: [
      { label: "Our Story", href: "/about/story/" },
      { label: "Gautam GS", href: "/about/founder/" },
      { label: "Philosophy", href: "/about/philosophy/" },
      { label: "Vision", href: "/about/vision/" },
    ],
  },
];
---

<header class="nav" data-solid={solid ? "" : undefined}>
  <div class="nav__inner container">
    <a class="nav__brand display" href="/" aria-label="Third Eye Events — home">
      Third&nbsp;Eye
    </a>

    <nav class="nav__desktop" aria-label="Primary">
      <ul role="list">
        {
          menu.map((item) => (
            <li class="nav__item">
              <button
                class="nav__link"
                aria-expanded="false"
                aria-controls={`menu-${item.label.toLowerCase().replace(/\s+/g, "-")}`}
              >
                {item.label}
              </button>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--ghost nav__cta" href="/contact/">Start a Conversation</a>

    <button class="nav__toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </div>

  <!-- Desktop mega panels -->
  {
    menu.map((item) => (
      <div class="mega" id={`menu-${item.label.toLowerCase().replace(/\s+/g, "-")}`} hidden>
        <div class="container mega__grid">
          <p class="mega__intro statement">{item.intro}</p>
          <ul role="list" class="mega__links">
            {item.links.map((link) => (
              <li>
                <a class="mega__link" href={link.href}>
                  <span>{link.label}</span>
                  {link.note && <small>{link.note}</small>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))
  }
</header>

<!-- Mobile full-screen menu -->
<div class="mobile-menu" id="mobile-menu" hidden aria-hidden="true" inert>
  <nav aria-label="Mobile" class="mobile-menu__nav container">
    <a class="mobile-menu__home display" href="/">Third Eye</a>
    {
      menu.map((item) => (
        <section class="mobile-menu__group">
          <h2>
            <button class="mobile-menu__trigger" aria-expanded="false">
              {item.label}
              <span aria-hidden="true">+</span>
            </button>
          </h2>
          <ul role="list" hidden>
            <li>
              <a href={item.href}>Overview</a>
            </li>
            {item.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <a class="btn btn--solid mobile-menu__cta" href="/contact/">Start a Conversation</a>
  </nav>
</div>

<style>
  /* ---------- Header shell ---------- */
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    transition:
      background-color var(--dur-standard) ease,
      backdrop-filter var(--dur-standard) ease,
      translate var(--dur-standard) var(--ease-out-expo),
      border-color var(--dur-standard) ease;
    border-bottom: 1px solid transparent;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    height: var(--nav-h);
  }

  .nav[data-solid],
  .nav.is-scrolled {
    background: rgba(10, 10, 10, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }

  .nav.is-hidden {
    translate: 0 -100%;
  }

  .nav__brand {
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .nav__desktop {
    margin-inline-start: auto;
  }

  .nav__desktop ul {
    display: flex;
    gap: clamp(1.25rem, 2.5vw, 2.75rem);
  }

  .nav__link {
    position: relative;
    padding-block: 0.6em;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-muted);
    transition: color var(--dur-micro) ease;
  }

  .nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--color-gold);
    scale: 0 1;
    transform-origin: left;
    transition: scale var(--dur-standard) var(--ease-out-expo);
  }

  .nav__link:hover,
  .nav__link[aria-expanded="true"] {
    color: var(--ink);
  }

  .nav__link:hover::after,
  .nav__link[aria-expanded="true"]::after {
    scale: 1 1;
  }

  .nav__cta {
    white-space: nowrap;
  }

  /* ---------- Mega ---------- */
  .mega {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: rgba(12, 12, 12, 0.94);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    translate: 0 -0.6rem;
    transition:
      opacity var(--dur-standard) ease,
      translate var(--dur-standard) var(--ease-out-expo);
  }

  .mega.is-open {
    opacity: 1;
    translate: 0 0;
    z-index: 1;
  }

  .mega__grid {
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) 2fr;
    gap: clamp(2rem, 5vw, 6rem);
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  .mega__intro {
    max-width: 22ch;
    font-size: 1.15rem;
  }

  .mega__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 3rem;
    align-content: start;
  }

  .mega__link {
    display: grid;
    gap: 0.2rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-standard) ease;
  }

  .mega__link span {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .mega__link small {
    font-size: 0.78rem;
    color: var(--ink-faint);
    line-height: 1.4;
  }

  .mega__link:hover span {
    color: var(--color-gold);
  }

  /* ---------- Mobile ---------- */
  .nav__toggle,
  .mobile-menu {
    display: none;
  }

  @media (max-width: 64em) {
    .nav__desktop,
    .nav__cta {
      display: none;
    }

    .nav__toggle {
      display: grid;
      place-content: center;
      gap: 7px;
      width: 44px;
      height: 44px;
      margin-inline-start: auto;
    }

    .nav__toggle span {
      width: 26px;
      height: 1.5px;
      background: var(--ink);
      transition:
        rotate var(--dur-standard) var(--ease-out-expo),
        translate var(--dur-standard) var(--ease-out-expo);
    }

    .nav__toggle[aria-expanded="true"] span:first-child {
      rotate: 45deg;
      translate: 0 4.25px;
    }

    .nav__toggle[aria-expanded="true"] span:last-child {
      rotate: -45deg;
      translate: 0 -4.25px;
    }

    .mobile-menu {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 90;
      overflow-y: auto;
      background: var(--color-ink);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur-standard) ease;
    }

    .mobile-menu.is-open {
      opacity: 1;
      pointer-events: auto;
    }

    .mobile-menu__nav {
      display: flex;
      flex-direction: column;
      padding-block: calc(var(--nav-h) + 2rem) 4rem;
      min-height: 100dvh;
    }

    .mobile-menu__home {
      font-size: 2rem;
      margin-bottom: 2.5rem;
    }

    .mobile-menu__group {
      border-top: 1px solid var(--line);
    }

    .mobile-menu__group h2 {
      margin: 0;
    }

    .mobile-menu__trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding-block: 1.1rem;
      font-family: var(--font-display);
      font-size: 1.7rem;
      font-weight: 340;
      text-align: left;
    }

    .mobile-menu__trigger span {
      font-family: var(--font-body);
      font-weight: 300;
      color: var(--color-gold);
      transition: rotate var(--dur-standard) var(--ease-out-expo);
    }

    .mobile-menu__trigger[aria-expanded="true"] span {
      rotate: 45deg;
    }

    .mobile-menu__group ul li a {
      display: block;
      padding-block: 0.55rem;
      color: var(--ink-muted);
      font-size: 1rem;
    }

    .mobile-menu__cta {
      margin-top: auto;
      padding-top: 3rem;
      justify-content: center;
    }
  }

  @media (min-width: 64.0625em) {
    .mega[hidden] {
      display: block;
      pointer-events: none;
    }
  }
</style>

<script>
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ── Window-level state (attached once, survives navigations) ── */
  let lastY = window.scrollY;
  let headerEl = null;
  let closeTimer;
  let closeMobileTimer: ReturnType<typeof setTimeout> | undefined;
  let mobileOpen = false;

  function onScroll() {
    if (!headerEl) return;
    const y = window.scrollY;
    headerEl.classList.toggle("is-scrolled", y > 24);
    if (!reducedMotion && !mobileOpen) {
      const goingDown = y > lastY && y > 420;
      headerEl.classList.toggle("is-hidden", goingDown);
    }
    lastY = y;
  }
  addEventListener("scroll", onScroll, { passive: true });

  function closeAllMegas() {
    document.querySelectorAll(".nav__link").forEach((t) => t.setAttribute("aria-expanded", "false"));
    document.querySelectorAll(".mega").forEach((m) => {
      m.classList.remove("is-open");
      m.setAttribute("hidden", "");
    });
  }

  function openMegaFor(btn) {
    clearTimeout(closeTimer);
    document.querySelectorAll(".nav__link").forEach((t) => t.setAttribute("aria-expanded", String(t === btn)));
    document.querySelectorAll(".mega").forEach((m) => {
      if (m.id === btn.getAttribute("aria-controls")) {
        m.removeAttribute("hidden");
        requestAnimationFrame(() => m.classList.add("is-open"));
      } else {
        m.classList.remove("is-open");
        m.setAttribute("hidden", "");
      }
    });
  }

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    closeAllMegas();
    closeMobile();
    document.querySelector(".nav__toggle")?.focus();
  });

  /* ── Mobile menu ── */
  let mobileFocusTrap: ((e: KeyboardEvent) => void) | null = null;

  function openMobile() {
    const burger = document.querySelector(".nav__toggle");
    const menu = document.getElementById("mobile-menu");
    if (!burger || !menu || mobileOpen) return;
    mobileOpen = true;
    menu.removeAttribute("hidden");
    menu.removeAttribute("aria-hidden");
    menu.removeAttribute("inert");
    requestAnimationFrame(() => menu.classList.add("is-open"));
    burger.setAttribute("aria-expanded", "true");
    burger.setAttribute("aria-label", "Close menu");
    document.body.style.overflow = "hidden";

    // Focus trap: cycle Tab within the mobile menu
    mobileFocusTrap = (e: KeyboardEvent) => {
      if (e.key !== "Tab" || !mobileOpen) return;
      const focusable = menu.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };
    document.addEventListener("keydown", mobileFocusTrap);
  }

  function closeMobile() {
    const burger = document.querySelector(".nav__toggle");
    const menu = document.getElementById("mobile-menu");
    if (!burger || !menu || !mobileOpen) return;
    mobileOpen = false;
    menu.classList.remove("is-open");
    closeMobileTimer = setTimeout(() => {
      menu.setAttribute("hidden", "");
      menu.setAttribute("aria-hidden", "true");
      menu.setAttribute("inert", "");
    }, reducedMotion ? 0 : 350);
    burger.setAttribute("aria-expanded", "false");
    burger.setAttribute("aria-label", "Open menu");
    document.body.style.overflow = "";

    if (mobileFocusTrap) {
      document.removeEventListener("keydown", mobileFocusTrap);
      mobileFocusTrap = null;
    }
  }

  /* ── Per-page DOM bindings — fresh elements each navigation ── */
  function initNav() {
    headerEl = document.querySelector(".nav");
    mobileOpen = false;
    document.body.style.overflow = "";
    clearTimeout(closeMobileTimer);
    onScroll();

    document.querySelectorAll(".nav__link").forEach((btn) => {
      btn.addEventListener("click", () =>
        btn.getAttribute("aria-expanded") === "true" ? closeAllMegas() : openMegaFor(btn),
      );
      const item = btn.closest(".nav__item");
      item?.addEventListener("mouseenter", () => {
        clearTimeout(closeTimer);
        openMegaFor(btn);
      });
      item?.addEventListener("mouseleave", () => {
        closeTimer = window.setTimeout(closeAllMegas, 350);
      });
    });

    // Keep mega open when hovering the panel itself
    document.querySelectorAll(".mega").forEach((mega) => {
      mega.addEventListener("mouseenter", () => clearTimeout(closeTimer));
      mega.addEventListener("mouseleave", () => {
        closeTimer = window.setTimeout(closeAllMegas, 200);
      });
    });

    document.querySelector(".nav__toggle")?.addEventListener("click", () =>
      mobileOpen ? closeMobile() : openMobile(),
    );

    document.querySelectorAll(".mobile-menu__trigger").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const panel = trigger.nextElementSibling;
        const open = trigger.getAttribute("aria-expanded") === "true";
        trigger.setAttribute("aria-expanded", String(!open));
        panel?.toggleAttribute("hidden", open);
      });
    });

    document.querySelectorAll("#mobile-menu a").forEach((a) => a.addEventListener("click", closeMobile));
  }

  document.addEventListener("astro:page-load", initNav);
</script>
