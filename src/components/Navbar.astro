---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  solid?: boolean;
}

const { solid = false } = Astro.props;
---

<nav class="navbar" data-solid={solid}>
  <div class="nav-container">
    <a href="/" class="nav-logo">
      <img src="/images/logo-white.svg" alt="Third Eye Events" width="140" height="40" />
    </a>

    <div class="nav-links">
      <a href="/destinations" class="nav-link">Destinations</a>
      <a href="/signature-experiences" class="nav-link">Signature Experiences</a>
      <a href="/ip-events" class="nav-link">IP Events</a>
      <a href="/services" class="nav-link">Services</a>
      <a href="/about" class="nav-link">About</a>
      <a href="/contact" class="nav-cta">Get in Touch</a>
    </div>

    <button class="nav-toggle" aria-label="Toggle Menu" aria-expanded="false" aria-controls="nav-menu">
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>
  </div>

  <div id="nav-menu" class="nav-overlay">
    <div class="overlay-content">
      <div class="overlay-links">
        <a href="/destinations" class="overlay-link">Destinations</a>
        <a href="/signature-experiences" class="overlay-link">Signature Experiences</a>
        <a href="/ip-events" class="overlay-link">IP Events</a>
        <a href="/services" class="overlay-link">Services</a>
        <a href="/about" class="overlay-link">About</a>
        <a href="/contact" class="overlay-cta">Get in Touch</a>
      </div>
    </div>
  </div>
</nav>

<script>
  function initNavbar() {
    const toggle = document.querySelector(".nav-toggle");
    const menu = document.querySelector(".nav-overlay");
    const links = document.querySelectorAll(".overlay-link, .overlay-cta");
    const body = document.body;

    if (!toggle || !menu) return;

    function toggleMenu(forceClose = false) {
      const isOpen = forceClose ? false : toggle.getAttribute("aria-expanded") === "true";
      const newState = !isOpen;

      toggle.setAttribute("aria-expanded", String(newState));
      menu.classList.toggle("is-open", newState);
      body.classList.toggle("no-scroll", newState);
      
      // Update burger icon state
      toggle.classList.toggle("is-active", newState);
    }

    toggle.addEventListener("click", () => toggleMenu());

    links.forEach(link => {
      link.addEventListener("click", () => toggleMenu(true));
    });

    // Close on Escape key
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.classList.contains("is-open")) {
        toggleMenu(true);
        toggle.focus();
      }
    });
  }

  document.addEventListener("astro:page-load", initNavbar);
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition: background 0.4s var(--ease-in-out-soft), padding 0.4s var(--ease-in-out-soft);
    padding: 1.5rem 0;
  }

  .navbar[data-solid="true"] {
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(12px);
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-logo img {
    display: block;
    transition: opacity 0.3s ease;
  }

  .nav-logo:hover img {
    opacity: 0.8;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-family: var(--font-manrope);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: color 0.3s ease;
    position: relative;
  }

  .nav-link:hover {
    color: #fff;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: #c5a059;
    transition: width 0.3s var(--ease-in-out-soft);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-cta {
    background: #c5a059;
    color: #000;
    text-decoration: none;
    padding: 0.6rem 1.2rem;
    font-family: var(--font-manrope);
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 2px;
    transition: transform 0.3s var(--ease-in-out-soft), background 0.3s ease;
  }

  .nav-cta:hover {
    background: #d4b57a;
    transform: translateY(-1px);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1100;
    width: 30px;
    height: 20px;
    position: relative;
    padding: 0;
  }

  .burger-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: #fff;
    transition: all 0.4s var(--ease-in-out-soft);
  }

  .burger-line:nth-child(1) { top: 0; }
  .burger-line:nth-child(2) { top: 10px; }
  .burger-line:nth-child(3) { top: 20px; }

  .nav-toggle.is-active .burger-line:nth-child(1) {
    transform: translateY(10px) rotate(45deg);
  }
  .nav-toggle.is-active .burger-line:nth-child(2) {
    opacity: 0;
    transform: translateX(-10px);
  }
  .nav-toggle.is-active .burger-line:nth-child(3) {
    transform: translateY(-10px) rotate(-45deg);
  }

  .nav-overlay {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 100vh;
    background: #0A0A0A;
    z-index: 1050;
    visibility: hidden;
    opacity: 0;
    transition: visibility 0.4s, opacity 0.5s var(--ease-in-out-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-overlay.is-open {
    visibility: visible;
    opacity: 1;
  }

  .overlay-content {
    text-align: center;
    width: 100%;
    max-width: 600px;
    padding: 0 2rem;
  }

  .overlay-links {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
  }

  .overlay-link {
    color: #fff;
    text-decoration: none;
    font-family: var(--font-fraunces);
    font-size: 2.5rem;
    font-weight: 400;
    transition: color 0.3s ease, transform 0.3s var(--ease-in-out-soft);
    opacity: 0;
    transform: translateY(20px);
  }

  .nav-overlay.is-open .overlay-link {
    animation: slideUp 0.6s var(--ease-in-out-soft) forwards;
  }

  .overlay-link:hover {
    color: #c5a059;
    transform: scale(1.05);
  }

  .overlay-cta {
    margin-top: 1rem;
    background: #c5a059;
    color: #000;
    text-decoration: none;
    padding: 1rem 2.5rem;
    font-family: var(--font-manrope);
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 2px;
    transition: background 0.3s ease;
    opacity: 0;
    transform: translateY(20px);
  }

  .nav-overlay.is-open .overlay-cta {
    animation: slideUp 0.6s var(--ease-in-out-soft) 0.4s forwards;
  }

  .overlay-cta:hover {
    background: #d4b57a;
  }

  @keyframes slideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1024px) {
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: block;
    }
  }
</style>
