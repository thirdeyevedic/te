---
/**
 * Opening Sequence — Cinematic "Ascension"
 *
 * A self-contained, auto-playing intro overlay. It is purely decorative and
 * MUST never leave the page covered or invisible.
 *
 * History — why this is written defensively:
 *  - The original drove the intro with ScrollTrigger `pin: true` on
 *    `trigger: 'body'`. Pinning the body made ScrollTrigger wrap <body> in a
 *    <div class="pin-spacer">, which detaches it from <html> and makes
 *    `document.body` evaluate to null. Every script that then touched
 *    document.body (notably BaseLayout removing the `page-fade-out`
 *    `opacity: 0` class) threw, so the whole page stayed invisible — a blank
 *    white screen. Rule: NEVER pin body/html. This component no longer uses
 *    ScrollTrigger or Lenis at all.
 *  - The intro now plays on its own timeline and always dismisses via one of
 *    several independent guarantees: timeline completion, the Skip button,
 *    the Escape key, a JS safety timer, and a pure-CSS fade backstop.
 */
---

<div class="cinema-stage" id="cinema-stage">
  <!-- GLOBAL FILM GRAIN -->
  <div class="film-grain" aria-hidden="true"></div>

  <!-- SCENE 1: THE VOID -->
  <div class="scene scene--void" id="scene-1">
    <div class="seed-container">
      <div class="seed" id="seed"></div>
      <div class="seed-glow" id="seed-glow"></div>
    </div>
    <div class="void-text" id="void-text">In the silence, the seed of intention is sown...</div>
  </div>

  <!-- SCENE 2: THE AWAKENING -->
  <div class="scene scene--awakening" id="scene-2">
    <div class="saffron-bloom" id="saffron-bloom"></div>
    <div class="awakening-text" id="awakening-text">
      <span class="word">Welcome</span>
      <span class="word">to</span>
      <span class="word">Satyug</span>
    </div>
  </div>

  <!-- SCENE 3: THE SACRED FRAGMENTS -->
  <div class="scene scene--fragments" id="scene-3">
    <div class="fragment-stage">
      <div class="fragment" id="frag-1">
        <div class="frag-img" style="background-image: url('/images/weddings/vedic-hero.jpg')"></div>
        <div class="frag-overlay"></div>
        <div class="frag-text">The Purity of Tradition</div>
      </div>
      <div class="fragment" id="frag-2">
        <div class="frag-img" style="background-image: url('/images/weddings/destination-hero.jpg')"></div>
        <div class="frag-overlay"></div>
        <div class="frag-text">The Breath of the Divine</div>
      </div>
      <div class="fragment" id="frag-3">
        <div class="frag-img" style="background-image: url('/images/weddings/concepts-hero.jpg')"></div>
        <div class="frag-overlay"></div>
        <div class="frag-text">A Sacred Sanskar</div>
      </div>
    </div>
  </div>

  <!-- SCENE 4: THE ASCENSION -->
  <div class="scene scene--ascension" id="scene-4">
    <div class="heaven-light" id="heaven-light"></div>
    <div class="celestial-mist" id="celestial-mist"></div>
    <div class="ascension-text" id="ascension-text">
      Third Eye Events: The Execution of Divinity
    </div>
  </div>

  <!-- PROGRESS INDICATOR -->
  <div class="cinema-progress" aria-hidden="true">
    <div class="progress-bar" id="progress-bar"></div>
  </div>

  <!-- SKIP CONTROL: real, focusable button — deliberately NOT inside any
       aria-hidden subtree, so keyboard and screen-reader users can bail out. -->
  <button type="button" id="opening-skip">Skip Intro</button>
</div>

<style>
  .cinema-stage {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #050505;
    overflow: hidden;
    color: var(--color-ivory, #f4f1ea);
    font-family: var(--font-serif, serif);
    cursor: none;
    transition: opacity 1s ease-in-out, visibility 1s;
    /* Pure-CSS backstop: if the module script never runs, the overlay still
       fades away on its own so the page is never permanently covered. */
    animation: fail-safe-reveal 12s forwards ease-in-out;
  }

  @keyframes fail-safe-reveal {
    0%,
    92% {
      opacity: 1;
      visibility: visible;
    }
    100% {
      opacity: 0;
      visibility: hidden;
    }
  }

  #opening-skip {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 30;
    padding: 0.6em 1.1em;
    background: transparent;
    border: 1px solid rgba(184, 155, 94, 0.5);
    border-radius: 2px;
    color: var(--color-gold, #b89b5e);
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  #opening-skip:hover,
  #opening-skip:focus-visible {
    background: rgba(184, 155, 94, 0.14);
    border-color: rgba(184, 155, 94, 0.8);
  }

  .film-grain {
    position: absolute;
    inset: -100% -100%;
    width: 300%;
    height: 300%;
    background-image: url('/images/noise.svg');
    opacity: 0.04;
    pointer-events: none;
    z-index: 10;
    animation: grain-drift 8s linear infinite;
  }

  @keyframes grain-drift {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(-50%, -50%);
    }
  }

  .scene {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .scene--void {
    background: radial-gradient(circle at center, #111 0%, #050505 100%);
  }
  .seed-container {
    position: relative;
    display: grid;
    place-items: center;
  }
  .seed {
    width: 3px;
    height: 3px;
    background: #fff;
    border-radius: 50%;
    z-index: 2;
  }
  .seed-glow {
    position: absolute;
    width: 100px;
    height: 100px;
    background: radial-gradient(circle, rgba(184, 155, 94, 0.4) 0%, transparent 70%);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    top: 50%;
    left: 50%;
  }
  .void-text {
    position: absolute;
    bottom: 15%;
    font-style: italic;
    font-size: 1.1rem;
    opacity: 0;
    letter-spacing: 0.15em;
    text-align: center;
    width: 100%;
  }

  .scene--awakening {
    z-index: 2;
  }
  .saffron-bloom {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(169, 85, 43, 0.3) 0%, transparent 75%);
    opacity: 0;
  }
  .awakening-text {
    font-size: clamp(2.2rem, 7vw, 4.5rem);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    text-align: center;
    z-index: 1;
    opacity: 0;
  }
  .awakening-text .word {
    display: inline-block;
    transform: translateY(30px);
    opacity: 0;
  }

  .scene--fragments {
    z-index: 3;
  }
  .fragment-stage {
    display: flex;
    gap: 4rem;
    padding: 4rem;
    perspective: 1000px;
  }
  .fragment {
    position: relative;
    width: 320px;
    height: 450px;
    opacity: 0;
    transform: scale(0.8) translateZ(-100px);
  }
  .frag-img {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    filter: contrast(1.1) brightness(0.7) saturate(0.8);
    border: 1px solid rgba(184, 155, 94, 0.2);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }
  .frag-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5, 5, 5, 0.8) 0%, transparent 50%);
  }
  .frag-text {
    position: absolute;
    bottom: 2rem;
    left: 0;
    width: 100%;
    text-align: center;
    font-style: italic;
    font-size: 1.1rem;
    color: var(--color-gold, #b89b5e);
    letter-spacing: 0.05em;
    opacity: 0;
  }

  .scene--ascension {
    z-index: 4;
  }
  .heaven-light {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, #fff 0%, #fff9e5 50%, transparent 100%);
    opacity: 0;
  }
  .celestial-mist {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.1) 0%, transparent 80%);
    opacity: 0.1;
    pointer-events: none;
  }
  .ascension-text {
    font-size: clamp(1.8rem, 5vw, 3.5rem);
    text-align: center;
    z-index: 1;
    opacity: 0;
    color: #222;
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .cinema-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.05);
    z-index: 10;
  }
  .progress-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--color-gold, #b89b5e), transparent);
  }

  @media (max-width: 1024px) {
    .fragment {
      width: 62vw;
      height: 84vw;
    }
    .fragment-stage {
      gap: 1.5rem;
      padding: 1.5rem;
    }
  }
</style>

<script>
  import gsap from "gsap";

  function initCinema() {
    const stage = document.getElementById("cinema-stage");
    if (!stage) return;

    // Played once per session — returning to the home page via the client
    // router must not re-cover the page or leave it locked.
    if (window.__thirdEyeIntroPlayed) {
      stage.remove();
      return;
    }
    window.__thirdEyeIntroPlayed = true;

    const reduce = document.documentElement.classList.contains("reduced-motion");
    const $ = (sel) => document.querySelector(sel);

    let done = false;
    let safetyTimer = 0;

    // Reveal whatever the intro was covering. Kept defensive: the page must be
    // visible even if this runs before BaseLayout's own page-load handler.
    function revealPage() {
      document.body?.classList.remove("page-fade-out");
      document.querySelectorAll(".hero .reveal, .hero .reveal-mask").forEach((el) => {
        el.classList.add("is-visible");
      });
    }

    function dismiss() {
      if (done) return;
      done = true;
      window.clearTimeout(safetyTimer);
      document.removeEventListener("keydown", onKeyDown);
      document.body && (document.body.style.overflow = "");
      stage.style.animation = "none"; // disable the CSS backstop once JS owns it
      revealPage();
      gsap.to(stage, {
        opacity: 0,
        duration: 0.9,
        ease: "power2.inOut",
        onComplete: () => {
          stage.style.display = "none";
          stage.remove();
        },
      });
    }

    function onKeyDown(e) {
      if (e.key === "Escape" || e.key === "Enter" || e.key === " ") dismiss();
    }

    document.getElementById("opening-skip")?.addEventListener("click", dismiss);
    document.addEventListener("keydown", onKeyDown);

    // Last-resort guarantee the overlay can never trap the page.
    safetyTimer = window.setTimeout(dismiss, 10000);

    if (reduce) {
      dismiss();
      return;
    }

    try {
      // Hold the page still while the intro plays, released on any exit path.
      document.body && (document.body.style.overflow = "hidden");

      const seed = $("#seed");
      const seedGlow = $("#seed-glow");
      const voidText = $("#void-text");
      const saffronBloom = $("#saffron-bloom");
      const heavenLight = $("#heaven-light");
      const ascensionText = $("#ascension-text");
      const progressBar = $("#progress-bar");

      const tl = gsap.timeline({ onComplete: dismiss });

      // SCENE 1 — THE VOID
      tl.set("#scene-1", { opacity: 1, visibility: "visible" }, 0)
        .to(seed || {}, { scale: 20, duration: 1.4, ease: "power1.inOut" }, 0)
        .to(seedGlow || {}, { scale: 15, opacity: 0.6, duration: 1.4 }, 0)
        .to(voidText || {}, { opacity: 1, y: -10, duration: 1 }, 0.5)
        .to(voidText || {}, { opacity: 0, duration: 0.7 }, 1.8);

      // SCENE 2 — THE AWAKENING
      tl.set("#scene-2", { opacity: 1, visibility: "visible" }, 2.4)
        .to(saffronBloom || {}, { opacity: 1, duration: 1.4 }, 2.4)
        .to("#scene-1", { opacity: 0, duration: 0.7 }, 2.4)
        .to(".awakening-text .word", {
          opacity: 1,
          y: 0,
          stagger: 0.25,
          duration: 1,
          ease: "power3.out",
        }, 2.9);

      // SCENE 3 — THE SACRED FRAGMENTS
      tl.set("#scene-3", { opacity: 1, visibility: "visible" }, 4.2)
        .to("#scene-2", { opacity: 0, duration: 0.7 }, 4.2)
        .to(".fragment", {
          opacity: 1,
          scale: 1,
          translateZ: 0,
          stagger: 0.45,
          duration: 1.4,
          ease: "power2.out",
        }, 4.5)
        .to(".frag-text", {
          opacity: 1,
          stagger: 0.45,
          duration: 0.7,
          ease: "power1.inOut",
        }, 5.1);

      // SCENE 4 — THE ASCENSION
      tl.set("#scene-3", { opacity: 0, duration: 0.6 }, 6.4)
        .set("#scene-4", { opacity: 1, visibility: "visible" }, 6.8)
        .to(heavenLight || {}, { opacity: 1, duration: 1 }, 6.8)
        .to(ascensionText || {}, {
          opacity: 1,
          scale: 1.1,
          duration: 0.9,
          ease: "power2.out",
        }, 7.1);

      // Progress bar fills across the whole sequence.
      tl.to(progressBar || {}, { width: "100%", duration: 8, ease: "none" }, 0);
    } catch (err) {
      console.error("Cinema failed to initialize:", err);
      dismiss();
    }
  }

  document.addEventListener("astro:page-load", initCinema);
</script>
