---
/**
 * Opening Sequence — Cinematic "Ascension"
 * A high-end, scroll-driven movie experience that leads the user from 
 * the Void into the divine realm of Satyug.
 */
---

<div class="cinema-stage" id="cinema-stage">
  <!-- GLOBAL FILM GRAIN -->
  <div class="film-grain" aria-hidden="true"></div>

  <!-- SCENE 1: THE VOID -->
  <div class="scene scene--void" id="scene-1">
    <div class="seed-container">
      <div class="seed" id="seed"></div>
      <div class="seed-glow" id="seed-glow"></div>
    </div>
    <div class="void-text" id="void-text">In the silence, the seed of intention is sown...</div>
  </div>

  <!-- SCENE 2: THE AWAKENING -->
  <div class="scene scene--awakening" id="scene-2">
    <div class="saffron-bloom" id="saffron-bloom"></div>
    <div class="awakening-text" id="awakening-text">
      <span class="word">Welcome</span>
      <span class="word">to</span>
      <span class="word">Satyug</span>
    </div>
  </div>

  <!-- SCENE 3: THE SACRED FRAGMENTS -->
  <div class="scene scene--fragments" id="scene-3">
    <div class="fragment-stage">
      <div class="fragment" id="frag-1">
        <div class="frag-img" style="background-image: url('/images/weddings/vedic-hero.jpg')"></div>
        <div class="frag-overlay"></div>
        <div class="frag-text">The Purity of Tradition</div>
      </div>
      <div class="fragment" id="frag-2">
        <div class="frag-img" style="background-image: url('/images/weddings/destination-hero.jpg')"></div>
        <div class="frag-overlay"></div>
        <div class="frag-text">The Breath of the Divine</div>
      </div>
      <div class="fragment" id="frag-3">
        <div class="frag-img" style="background-image: url('/images/weddings/concepts-hero.jpg')"></div>
        <div class="frag-overlay"></div>
        <div class="frag-text">A Sacred Sanskar</div>
      </div>
    </div>
  </div>

  <!-- SCENE 4: THE ASCENSION -->
  <div class="scene scene--ascension" id="scene-4">
    <div class="heaven-light" id="heaven-light"></div>
    <div class="celestial-mist" id="celestial-mist"></div>
    <div class="ascension-text" id="ascension-text">
      Third Eye Events: The Execution of Divinity
    </div>
  </div>

  <!-- PROGRESS INDICATOR -->
  <div class="cinema-progress">
    <div class="progress-bar" id="progress-bar"></div>
  </div>
</div>

<style>
  .cinema-stage {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #050505;
    overflow: hidden;
    color: var(--color-ivory);
    font-family: var(--font-serif);
    cursor: none;
  }

  .film-grain {
    position: absolute;
    inset: -100% -100%;
    width: 300%;
    height: 300%;
    background-image: url('https://grainy-gradients.vercel.app/noise.svg');
    opacity: 0.04;
    pointer-events: none;
    z-index: 10;
    animation: grain-drift 8s linear infinite;
  }

  @keyframes grain-drift {
    from { transform: translate(0, 0); }
    to { transform: translate(-50%, -50%); }
  }

  .scene {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .scene--void {
    background: radial-gradient(circle at center, #111 0%, #050505 100%);
  }
  .seed-container {
    position: relative;
    display: grid;
    place-items: center;
  }
  .seed {
    width: 3px;
    height: 3px;
    background: #fff;
    border-radius: 50%;
    z-index: 2;
  }
  .seed-glow {
    position: absolute;
    width: 100px;
    height: 100px;
    background: radial-gradient(circle, rgba(184, 155, 94, 0.4) 0%, transparent 70%);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    top: 50%;
    left: 50%;
  }
  .void-text {
    position: absolute;
    bottom: 15%;
    font-style: italic;
    font-size: 1.1rem;
    opacity: 0;
    letter-spacing: 0.15em;
    text-align: center;
    width: 100%;
  }

  .scene--awakening {
    z-index: 2;
  }
  .saffron-bloom {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(169, 85, 43, 0.3) 0%, transparent 75%);
    opacity: 0;
  }
  .awakening-text {
    font-size: clamp(2.2rem, 7vw, 4.5rem);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    text-align: center;
    z-index: 1;
    opacity: 0;
  }
  .awakening-text .word {
    display: inline-block;
    transform: translateY(30px);
    opacity: 0;
  }

  .scene--fragments {
    z-index: 3;
  }
  .fragment-stage {
    display: flex;
    gap: 4rem;
    padding: 4rem;
    perspective: 1000px;
  }
  .fragment {
    position: relative;
    width: 320px;
    height: 450px;
    opacity: 0;
    transform: scale(0.8) translateZ(-100px);
  }
  .frag-img {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    filter: contrast(1.1) brightness(0.7) saturate(0.8);
    border: 1px solid rgba(184, 155, 94, 0.2);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }
  .frag-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5,5,5,0.8) 0%, transparent 50%);
  }
  .frag-text {
    position: absolute;
    bottom: 2rem;
    left: 0;
    width: 100%;
    text-align: center;
    font-style: italic;
    font-size: 1.1rem;
    color: var(--color-gold);
    letter-spacing: 0.05em;
    opacity: 0;
  }

  .scene--ascension {
    z-index: 4;
  }
  .heaven-light {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, #fff 0%, #fff9e5 50%, transparent 100%);
    opacity: 0;
  }
  .celestial-mist {
    position: absolute;
    inset: 0;
    background: url('https://www.transparenttextures.com/patterns/clouds.png');
    opacity: 0.1;
    filter: invert(1);
    pointer-events: none;
  }
  .ascension-text {
    font-size: clamp(1.8rem, 5vw, 3.5rem);
    text-align: center;
    z-index: 1;
    opacity: 0;
    color: #222;
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .cinema-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: rgba(255,255,255,0.05);
    z-index: 10;
  }
  .progress-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger);

  function initCinema() {
    const stage = document.getElementById('cinema-stage');
    if (!stage) return;

    // SAFETY VALVE: Force reveal if cinematic doesn't start in 6s
    const safetyTimer = setTimeout(() => {
      console.warn('Cinematic intro timeout: Forcing reveal');
      gsap.to(stage, { 
        opacity: 0, 
        duration: 1, 
        onComplete: () => {
          stage.style.display = 'none';
          document.body.style.overflow = '';
        }
      });
    }, 6000);

    const lenis = new Lenis({
      duration: 1.5,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    });

    lenis.on('scroll', () => {
      // Clear safety timer once user starts interacting
      clearTimeout(safetyTimer);
      ScrollTrigger.update();
    });

    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);

    document.body.style.overflow = 'hidden';

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: 'body',
        start: 'top top',
        end: '+=500%', 
        scrub: 1,
        pin: true,
        onLeave: () => {
          const heroContent = document.querySelector('.hero__content');
          const heroTitle = document.querySelector('.hero__title');
          
          gsap.to(stage, { 
            opacity: 0, 
            duration: 1.5, 
            ease: 'power2.inOut',
            onComplete: () => {
              stage.style.display = 'none';
              document.body.style.overflow = '';
              
              if (heroContent) {
                gsap.fromTo(heroContent, { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out' });
              }
              if (heroTitle) {
                gsap.fromTo(heroTitle, { scale: 0.9, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.5, delay: 0.3, ease: 'power3.out' });
              }
            }
          });
        }
      }
    });

    tl.set('#scene-1', { opacity: 1, visibility: 'visible' })
      .to('#seed', { scale: 20, duration: 2, ease: 'power1.inOut' })
      .to('#seed-glow', { scale: 15, opacity: 0.6, duration: 2 }, 0)
      .to('#void-text', { opacity: 1, y: -10, duration: 1.5 }, 1)
      .to('#void-text', { opacity: 0, duration: 1 }, '+=1');

    tl.set('#scene-2', { opacity: 1, visibility: 'visible' })
      .to('#saffron-bloom', { opacity: 1, duration: 2 })
      .to('.awakening-text .word', { 
        opacity: 1, 
        y: 0, 
        stagger: 0.3, 
        duration: 1.5, 
        ease: 'power3.out' 
      }, '-=1')
      .to('#scene-1', { opacity: 0, duration: 1 }, '-=0.5');

    tl.set('#scene-3', { opacity: 1, visibility: 'visible' })
      .to('#scene-2', { opacity: 0, duration: 1 })
      .to('.fragment', { 
        opacity: 1, 
        scale: 1, 
        translateZ: 0,
        stagger: 0.7, 
        duration: 2,
        ease: 'power2.out'
      })
      .to('.frag-text', { 
        opacity: 1, 
        stagger: 0.7, 
        duration: 1,
        ease: 'power1.inOut'
      }, '-=1')
      .to('#scene-3', { opacity: 0, duration: 1 }, '+=2');

    tl.set('#scene-4', { opacity: 1, visibility: 'visible' })
      .to('#heaven-light', { opacity: 1, duration: 2 })
      .to('#ascension-text', { 
        opacity: 1, 
        scale: 1.1, 
        duration: 2, 
        ease: 'power2.out' 
      }, '-=1')
      .to('#progress-bar', { width: '100%', duration: 10 }, 0);
  }

  document.addEventListener('astro:page-load', initCinema);
</script>
