---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/manrope";
// Resolved by the bundler so the preload href matches the hashed asset the
// stylesheet actually loads. Both families are *variable*, so a single file
// per family covers every weight — preloading 400 and 600 separately was
// redundant as well as pointing at filenames that never existed.
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2";
import manropeLatin from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Cursor from "../components/Cursor.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  /** JSON-LD blocks, injected verbatim */
  structuredData?: Record<string, unknown>[];
  /** Disables transparent-over-hero nav (default: overlay nav on) */
  solidNav?: boolean;
  /** Excludes the page from search indexing (utility pages) */
  noindex?: boolean;
}

const { title, description, path = "", structuredData = [], solidNav = false, noindex = false } = Astro.props;

const site = Astro.site ?? new URL("https://thirdeyeevents.com");
const canonical = new URL(path, site);
const ogImage = new URL("/images/og.jpg", site);

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site}#organization`,
  name: "Third Eye Events",
  alternateName: "Third Eye",
  url: site.href,
  description:
    "Third Eye Events is a multi-domain experience and execution powerhouse — Vaidik luxury weddings, destination weddings, signature experiences, owned event IP, production facilitation and cultural events.",
  founder: {
    "@type": "Person",
    "@id": `${site}#gautam-gs`,
    name: "Gautam GS",
    jobTitle: "Founder · Director · Choreographer · Designer",
  },
  knowsAbout: [
    "Vaidik Weddings",
    "Vivaah Sanskar",
    "Destination Weddings",
    "Experience Design",
    "Event IP",
    "Line Production",
  ],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site}#website`,
  url: site.href,
  name: "Third Eye Events",
  publisher: { "@id": `${site}#organization` },
  inLanguage: "en-IN",
};

const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonical.href,
  url: canonical.href,
  name: title,
  description,
  isPartOf: { "@id": `${site}#website` },
  about: { "@id": `${site}#organization` },
  inLanguage: "en-IN",
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A0A0A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Third Eye Events" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Font preloads for performance -->
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />

    {/* JSON-LD is data, not a script to bundle or process — `is:inline` says so
        explicitly instead of leaving Astro to infer it from the attributes. */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(website)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webPage)} />
    {structuredData.map((block) => <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />)}

<script is:inline>
       document.documentElement.dataset.nav = "overlay";
       if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
         document.documentElement.classList.add("reduced-motion");
       }
     </script>
   </head>

  <body data-solid-nav={solidNav ? "" : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navbar solid={solidNav} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="grain" aria-hidden="true"></div>
    <Cursor />

    <script>
      /* Scroll reveals — re-initialised on every astro:page-load */
      function initReveals() {
        const revealables = document.querySelectorAll(".reveal, .reveal-mask");
        if (document.documentElement.classList.contains("reduced-motion")) {
          revealables.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        revealables.forEach((el) => io.observe(el));
      }

      document.addEventListener("astro:page-load", initReveals);
    </script>
  </body>
</html>
