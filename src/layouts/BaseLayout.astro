---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/manrope";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Cursor from "../components/Cursor.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  /** JSON-LD blocks, injected verbatim */
  structuredData?: Record<string, unknown>[];
  /** Disables transparent-over-hero nav (default: overlay nav on) */
  solidNav?: boolean;
  /** Excludes the page from search indexing (utility pages) */
  noindex?: boolean;
}

const { title, description, path = "", structuredData = [], solidNav = false, noindex = false } = Astro.props;

const site = Astro.site ?? new URL("https://thirdeyeevents.com");
const canonical = new URL(path, site);
const ogImage = new URL("/images/og.jpg", site);

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site}#organization`,
  name: "Third Eye Events",
  alternateName: "Third Eye",
  url: site.href,
  description:
    "Third Eye Events is a multi-domain experience and execution powerhouse — Vaidik luxury weddings, destination weddings, signature experiences, owned event IP, production facilitation and cultural events.",
  founder: {
    "@type": "Person",
    "@id": `${site}#gautam-gs`,
    name: "Gautam GS",
    jobTitle: "Founder · Director · Choreographer · Designer",
  },
  knowsAbout: [
    "Vaidik Weddings",
    "Vivaah Sanskar",
    "Destination Weddings",
    "Experience Design",
    "Event IP",
    "Line Production",
  ],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site}#website`,
  url: site.href,
  name: "Third Eye Events",
  publisher: { "@id": `${site}#organization` },
  inLanguage: "en-IN",
};

const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonical.href,
  url: canonical.href,
  name: title,
  description,
  isPartOf: { "@id": `${site}#website` },
  about: { "@id": `${site}#organization` },
  inLanguage: "en-IN",
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A0A0A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Third Eye Events" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Font preloads for performance -->
    <link rel="preload" href="/@fontsource-variable/fraunces/files/fraunces-latin-wght-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/@fontsource-variable/fraunces/files/fraunces-latin-wght-600.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/@fontsource-variable/manrope/files/manrope-latin-wght-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/@fontsource-variable/manrope/files/manrope-latin-wght-600.woff2" as="font" type="font/woff2" crossorigin>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPage)} />
    {structuredData.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

<script is:inline>
       document.documentElement.dataset.nav = "overlay";
       if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
         document.documentElement.classList.add("reduced-motion");
       }
     </script>
     
     <!-- Analytics Foundation -->
     <script is:inline>
       // Analytics placeholder - replace with actual implementation (Google Analytics, Plausible, etc.)
       window.trackEvent = function(eventName, properties = {}) {
         console.log('[Analytics]', eventName, properties);
         // In production, send to analytics service
         // Example: gtag('event', eventName, properties);
       };
       
       // Track page views
       window.trackEvent('page_view', {
         page: location.pathname,
         title: document.title
       });
     </script>
     
     <!-- Error Tracking Foundation -->
     <script is:inline>
       // Error tracking placeholder - replace with actual implementation (Sentry, etc.)
       window.trackError = function(error, context = {}) {
         console.error('[Error Tracking]', error, context);
         // In production, send to error tracking service
         // Example: Sentry.captureException(error, { context });
       };
       
       // Global error handler
       window.addEventListener('error', function(e) {
         window.trackError(e.error, {
           filename: e.filename,
           lineno: e.lineno,
           colno: e.colno
         });
       });
       
       // Unhandled promise rejection handler
       window.addEventListener('unhandledrejection', function(e) {
         window.trackError(e.reason, {
           promise: e.promise
         });
       });
     </script>
     
     <!-- i18n Foundation -->
     <script is:inline>
       // Internationalization foundation - replace with actual implementation (i18next, etc.)
       window.i18n = {
         locale: 'en', // default locale
         translations: {
           en: {
             // English translations would go here
             'navigation.weddings': 'Weddings',
             'navigation.event-ip': 'Event IP',
             'navigation.production': 'Production',
             'navigation.about': 'About',
             'navigation.contact': 'Contact'
           }
           // Other locales would be added here
         },
         get: function(key, locale = this.locale) {
           const keys = key.split('.');
           let value = this.translations[locale];
           for (const k of keys) {
             if (value && typeof value === 'object') {
               value = value[k];
             } else {
               return key; // fallback to key if not found
             }
           }
           return value !== undefined && value !== null ? value : key;
         }
       };
     </script>
   </head>

  <body data-solid-nav={solidNav ? "" : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navbar solid={solidNav} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="grain" aria-hidden="true"></div>
    <Cursor />

    <script>
      /* Scroll reveals — re-initialised on every astro:page-load */
      function initReveals() {
        const revealables = document.querySelectorAll(".reveal, .reveal-mask");
        if (document.documentElement.classList.contains("reduced-motion")) {
          revealables.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        revealables.forEach((el) => io.observe(el));
      }

      document.addEventListener("astro:page-load", initReveals);
    </script>
  </body>
</html>
