---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/manrope";
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2";
import manropeLatin from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Cursor from "../components/Cursor.astro";
import { SITE_URL, SITE_NAME, GA_MEASUREMENT_ID } from "../data/site";
import { buildLocalBusiness } from "../utils/schema";

interface Props {
  title: string;
  description: string;
  path?: string;
  structuredData?: Record<string, unknown>[];
  solidNav?: boolean;
  noindex?: boolean;
  bare?: boolean;
}

const { title, description, path = "", structuredData = [], solidNav = false, noindex = false, bare = false } = Astro.props;

const site = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(path, site);
const ogImage = new URL("/images/og.jpg", site);

// Optional Cloudflare Web Analytics beacon — off unless PUBLIC_CF_BEACON_TOKEN
// is set at build time, so local/preview builds never leak a real token.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;

const localBusiness = buildLocalBusiness(site.href);

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site}#organization`,
  name: SITE_NAME,
  alternateName: "Third Eye",
  url: site.href,
  description:
    "Third Eye Events is a multi-domain experience and execution powerhouse — Vedic luxury weddings, destination weddings, signature experiences, owned IP Events, production facilitation and cultural events.",
  founder: {
    "@type": "Person",
    "@id": `${site}#gautam-gs`,
    name: "Gautam GS",
    jobTitle: "Founder · Director · Choreographer · Designer",
  },
  knowsAbout: [
    "Vedic Weddings",
    "Vivaah Sanskar",
    "Destination Weddings",
    "Experience Design",
    "IP Events",
    "Line Production",
  ],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site}#website`,
  url: site.href,
  name: SITE_NAME,
  publisher: { "@id": `${site}#organization` },
  inLanguage: "en-IN",
};

const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonical.href,
  url: canonical.href,
  name: title,
  description,
  isPartOf: { "@id": `${site}#website` },
  about: { "@id": `${site}#organization` },
  inLanguage: "en-IN",
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A0A0A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:secure_url" content={ogImage.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Third Eye Events — luxury weddings and experiences" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content="Third Eye Events — luxury weddings and experiences" />

    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(website)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webPage)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    {structuredData.map((block) => <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />)}

    {cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      />
    )}

    {/* Google Analytics 4 (gtag.js) — on every public page, never on the
        bare (admin) layout. The shim must be inline and synchronous so the
        js/config events queue before the async library loads. */}
    {!bare && GA_MEASUREMENT_ID && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`} />
    )}
    {!bare && GA_MEASUREMENT_ID && (
      <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag("js", new Date());
        window.gtag("config", gaId);
      </script>
    )}

    <script is:inline>
      document.documentElement.dataset.nav = "overlay";
      if (matchMedia("(prefers-reduced-motion: reduce").matches) {
        document.documentElement.classList.add("reduced-motion");
      }
    </script>
  </head>

  <body data-solid-nav={solidNav ? "" : undefined} class="page-fade-out">
    {!bare && <a class="skip-link" href="#main">Skip to content</a>}
    {!bare && <Navbar solid={solidNav} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <div class="grain" aria-hidden="true"></div>}
    {!bare && <Cursor />}

    <script>
      declare global {
        interface Window {
          gtag?: (...args: unknown[]) => void;
          __teGa?: { firstDone: boolean; listening: boolean };
        }
      }

      function initReveals() {
        const revealables = document.querySelectorAll(".reveal, .reveal-mask");
        if (document.documentElement.classList.contains("reduced-motion")) {
          revealables.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        revealables.forEach((el) => io.observe(el));
      }

      /* Google Analytics + ClientRouter: a view-transition swap is not a
         document load, so GA never sees those navigations. Send a page_view
         on every virtual navigation — skipping the first, which
         gtag("config") in <head> already reports. The state lives on window
         because Astro re-executes this module after every swap (the same
         reason initNav is idempotent-guarded). */
      const gaState = (window.__teGa ??= { firstDone: false, listening: false });
      if (!gaState.listening) {
        gaState.listening = true;
        document.addEventListener("astro:page-load", () => {
          if (!gaState.firstDone) {
            gaState.firstDone = true;
            return;
          }
          if (typeof window.gtag === "function") {
            window.gtag("event", "page_view", {
              page_location: window.location.href,
              page_path: `${window.location.pathname}${window.location.search}`,
              page_title: document.title,
            });
          }
        });
      }

      document.addEventListener("astro:page-load", () => {
        initReveals();
        // Cinematic page entry fade
        document.body.classList.remove("page-fade-out");
      });
    </script>
  </body>
</html>

<style>
  .page-fade-out {
    opacity: 0;
    transition: opacity 800ms var(--ease-in-out-soft);
  }
  body:not(.page-fade-out) {
    opacity: 1;
  }
</style>
